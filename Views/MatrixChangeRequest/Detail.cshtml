@{
    ViewData["Title"] = "Change Request";
    var changeRequestId = ViewData["ChangeRequestId"] is int id ? id : 0;
}

<style>
    .cr-cell { cursor: pointer; min-width: 130px; }
    .cr-rowhdr, .cr-colhdr { cursor: pointer; }
    .cr-cell.cr-selected { background-color: var(--bs-primary-bg-subtle, #cfe2ff) !important; outline: 2px solid var(--bs-primary, #0d6efd); outline-offset: -2px; }
    .cr-removed td { text-decoration: line-through; opacity: .6; }
</style>

<div class="container-fluid">

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <a id="crBack" href="#" class="text-decoration-none small">
                <i class="fas fa-arrow-left me-1"></i>Back to Training Matrix
            </a>
            <h4 class="mb-0 fw-medium mt-1">
                <i class="fa-solid fa-file-pen me-2"></i>Change Request - <span id="crTitle"></span>
                <span id="crStatus" class="badge ms-2 align-middle"></span>
            </h4>
            <div class="text-muted small" id="crSub"></div>
        </div>
        <div id="crActions" class="d-flex flex-wrap gap-2"></div>
    </div>

    <div class="alert alert-secondary py-2 mb-2">
        <b>Alasan:</b> <span id="crReason"></span>
    </div>
    <div id="crNotice" class="alert d-none py-2" role="alert"></div>

    @Html.AntiForgeryToken()

    <!-- ===== Matrix saat ini ===== -->
    <div class="card card-compact mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0 fw-medium"><i class="fas fa-border-all me-2"></i>Matrix saat ini (Approved)</h6>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-muted">
                    <span class="badge bg-danger">M</span> Mandatory
                    <span class="badge bg-info text-dark ms-1">R</span> Recommended
                    <span class="badge bg-success ms-1">+n</span> Add
                    <span class="badge bg-dark ms-1">−n</span> Remove
                </span>
                <span class="small text-muted" id="crSelInfo">Klik sel / nama baris / header layer untuk memilih.</span>
                <button type="button" class="btn btn-xs btn-outline-secondary" id="crClearSel">Clear selection</button>
                <button type="button" class="btn btn-xs btn-primary d-none cr-edit-only" id="crBtnAdd" disabled>
                    <i class="fas fa-plus me-1"></i>Add course / group
                </button>
            </div>
        </div>
        <div class="card-body p-0 table-responsive" style="max-height: 420px;">
            <table class="table table-bordered table-sm mb-0 align-middle" id="crGrid">
                <thead class="table-dark" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th>Sub Department</th>
                        <th class="text-center cr-colhdr" data-layer="1">Layer 1</th>
                        <th class="text-center cr-colhdr" data-layer="2">Layer 2</th>
                        <th class="text-center cr-colhdr" data-layer="3">Layer 3</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div class="card card-compact mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0 fw-medium"><i class="fas fa-list me-2"></i>Course matrix saat ini <span class="text-muted small" id="crRowsInfo"></span></h6>
            <div class="d-none cr-edit-only">
                <button type="button" class="btn btn-xs btn-danger" id="crBtnRemove" disabled>
                    <i class="fas fa-minus-circle me-1"></i>Mark for removal
                </button>
            </div>
        </div>
        <div class="card-body p-2 overflow-hidden">
            <table id="crRows" class="table table-striped table-compact w-100"></table>
        </div>
    </div>

    <!-- ===== Perubahan ===== -->
    <div class="card card-compact">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0 fw-medium"><i class="fas fa-code-compare me-2"></i>Perubahan yang diajukan <span class="text-muted small" id="crChangesInfo"></span></h6>
            <div class="d-none cr-edit-only">
                <button type="button" class="btn btn-xs btn-outline-secondary" id="crBtnUndo" disabled>
                    <i class="fas fa-rotate-left me-1"></i>Undo selected
                </button>
            </div>
        </div>
        <div class="card-body p-2 overflow-hidden">
            <table id="crChanges" class="table table-striped table-compact w-100"></table>
        </div>
    </div>
</div>

<!-- ===== Modal Add ===== -->
<div class="modal fade" id="crAddModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tambah course ke sel terpilih</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-secondary py-2 small mb-3" id="amSummary"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label for="amGroup" class="form-label fw-medium">Course Group (opsional)</label>
                        <select id="amGroup" class="form-select"></select>
                        <div class="form-text">Course yang sudah ada di matrix atau di Change Request ini akan dilewati.</div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-medium d-block">Requirement</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="amReq" id="amReqM" value="Mandatory" checked />
                            <label class="form-check-label" for="amReqM">Mandatory</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="amReq" id="amReqR" value="Recommended" />
                            <label class="form-check-label" for="amReqR">Recommended</label>
                        </div>
                    </div>
                </div>

                <label class="form-label fw-medium">
                    Course tambahan (opsional)
                    <span class="badge bg-primary ms-1" id="amCount">0</span>
                </label>
                <input type="search" id="amSearch" class="form-control form-control-sm mb-2"
                       placeholder="Search course code / name..." autocomplete="off" />
                <div id="amCourseList" class="border rounded" style="max-height: 300px; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="amApply"><i class="fas fa-check me-1"></i>Add</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        window.crCfg = {

            changeRequestId: @changeRequestId,

            urls: {

                getDetail: '@Url.Action("GetDetail", "MatrixChangeRequest")',

                addCourses: '@Url.Action("AddCourses", "MatrixChangeRequest")',

                markRemove: '@Url.Action("MarkRemove", "MatrixChangeRequest")',

                undoChanges: '@Url.Action("UndoChanges", "MatrixChangeRequest")',

                remove: '@Url.Action("Delete", "MatrixChangeRequest")',

                transition: '@Url.Action("Transition", "MatrixChangeRequest")',

                matrixDetail: '@Url.Action("Detail", "TrainingMatrix")',

                groups: '@Url.Action("GetList", "CourseGroup")',

                courseOptions: '@Url.Action("GetCourseOptions", "CourseGroup")'

            }

        };

    </script>

    <script src="~/js/matrix-change-request.js" asp-append-version="true"></script>

}
