@{
    ViewData["Title"] = "Course Group";
    var canEdit = ViewData["CanEdit"] is true;
}

<div class="container-fluid">

    <div class="row justify-content-between align-items-center mb-4">
        <div class="col-12 col-md-auto">
            <h4 class="mb-0 fw-medium">
                <i class="fa-solid fa-layer-group me-2"></i>Course Group
            </h4>
            <div class="text-muted small">
                Paket course yang dipakai ulang saat menyusun Training Matrix.
            </div>
        </div>

        @if (canEdit)
        {
            <div class="col-12 col-md-auto mt-2 mt-md-0">
                <button type="button" class="btn btn-primary" id="btnAddGroup">
                    <i class="bi bi-plus-lg me-1"></i>Add Course Group
                </button>
            </div>
        }
    </div>

    @Html.AntiForgeryToken()

    <div class="card card-compact">
        <div class="card-body p-2 overflow-hidden">
            <table id="cgTable" class="table table-striped table-compact w-100"></table>
        </div>
    </div>
</div>

<!-- ===== Modal: Add / Edit / View ===== -->
<div class="modal fade" id="cgModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cgModalTitle">Course Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="cgId" value="0" />

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label for="cgName" class="form-label fw-medium">Group Name <span class="text-danger">*</span></label>
                        <input type="text" id="cgName" class="form-control" maxlength="100" autocomplete="off" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="cgActive" checked />
                            <label class="form-check-label" for="cgActive">Active</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label for="cgDesc" class="form-label fw-medium">Description</label>
                        <textarea id="cgDesc" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <label class="form-label fw-medium mb-0">
                        Courses <span class="text-danger">*</span>
                        <span class="badge bg-primary ms-1" id="cgSelectedCount">0</span>
                    </label>
                    <div class="form-check form-switch mb-0" id="cgOnlySelectedWrap">
                        <input class="form-check-input" type="checkbox" id="cgOnlySelected" />
                        <label class="form-check-label small" for="cgOnlySelected">Show selected only</label>
                    </div>
                </div>

                <input type="search" id="cgSearch" class="form-control form-control-sm mb-2"
                       placeholder="Search course code / name..." autocomplete="off" />

                <div id="cgCourseList" class="border rounded" style="max-height: 340px; overflow-y: auto;"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                @if (canEdit)
                {
                    <button type="button" class="btn btn-primary" id="cgSave">
                        <i class="fas fa-save me-1"></i>Save
                    </button>
                }
            </div>
        </div>
    </div>
</div>
<partial name="_GroupImpactModal" />

@section Scripts {

    <script>

        window.courseGroupCfg = {

            canEdit: @(canEdit ? "true" : "false"),

            urls: {

                getList: '@Url.Action("GetList", "CourseGroup")',

                getDetail: '@Url.Action("GetDetail", "CourseGroup")',

                getCourseOptions: '@Url.Action("GetCourseOptions", "CourseGroup")',

                save: '@Url.Action("Save", "CourseGroup")',

                remove: '@Url.Action("Delete", "CourseGroup")'

            }

        };

    </script>
    <script>
            window.groupImpactCfg = {
                canEdit: @(canEdit ? "true" : "false"),
                urls: {
                    getImpact: '@Url.Action("GetImpact", "GroupImpact")',
                    apply: '@Url.Action("Apply", "GroupImpact")',
                    crDetail: '@Url.Action("Detail", "MatrixChangeRequest")'
                }
            };
        </script>
    <script src="~/js/course-group.js" asp-append-version="true"></script>
    <script src="~/js/group-impact.js" asp-append-version="true"></script>
}
