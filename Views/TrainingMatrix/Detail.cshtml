@{
    ViewData["Title"] = "Training Matrix";
    var matrixId = ViewData["MatrixId"] is int id ? id : 0;
}

<style>
    .tm-cell { cursor: pointer; min-width: 110px; }
    .tm-rowhdr, .tm-colhdr { cursor: pointer; }
    .tm-cell.tm-selected { background-color: var(--bs-primary-bg-subtle, #cfe2ff) !important; outline: 2px solid var(--bs-primary, #0d6efd); outline-offset: -2px; }
    .tm-locked .tm-cell, .tm-locked .tm-rowhdr, .tm-locked .tm-colhdr { cursor: default; }
</style>

<div class="container-fluid">

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <a asp-controller="TrainingMatrix" asp-action="Index" class="text-decoration-none small">
                <i class="fas fa-arrow-left me-1"></i>All departments
            </a>
            <h4 class="mb-0 fw-medium mt-1">
                <i class="fa-solid fa-table-cells me-2"></i>Training Matrix - <span id="tmTitle"></span>
                <span id="tmStatus" class="badge ms-2 align-middle"></span>
            </h4>
            <div class="text-muted small" id="tmSub"></div>
        </div>
        <div id="tmActions" class="d-flex flex-wrap gap-2"></div>
    </div>

    <div id="tmNotice" class="alert d-none py-2" role="alert"></div>

    @Html.AntiForgeryToken()

    <!-- ===== Grid Sub Department x Layer ===== -->
    <div class="card card-compact mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0 fw-medium"><i class="fas fa-border-all me-2"></i>Sub Department × Layer</h6>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-muted">
                    <span class="badge bg-danger">M</span> Mandatory
                    <span class="badge bg-info text-dark ms-2">R</span> Recommended
                </span>
                <span class="small text-muted" id="tmSelInfo">Klik sel / nama baris / header layer untuk memilih.</span>
                <button type="button" class="btn btn-xs btn-outline-secondary" id="tmClearSel">Clear selection</button>
                <button type="button" class="btn btn-xs btn-primary d-none tm-edit-only" id="tmBtnApply" disabled>
                    <i class="fas fa-plus me-1"></i>Apply course / group
                </button>
            </div>
        </div>
        <div class="card-body p-0 table-responsive" style="max-height: 480px;">
            <table class="table table-bordered table-sm mb-0 align-middle" id="tmGrid">
                <thead class="table-dark" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th>Sub Department</th>
                        <th class="text-center tm-colhdr" data-layer="1">Layer 1</th>
                        <th class="text-center tm-colhdr" data-layer="2">Layer 2</th>
                        <th class="text-center tm-colhdr" data-layer="3">Layer 3</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <!-- ===== Detail rows ===== -->
    <div class="card card-compact">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0 fw-medium"><i class="fas fa-list me-2"></i>Courses <span class="text-muted small" id="tmRowsInfo"></span></h6>
            <div class="d-none tm-edit-only d-flex gap-2">
                <button type="button" class="btn btn-xs btn-outline-danger" id="tmBtnMandatory" disabled>Set Mandatory</button>
                <button type="button" class="btn btn-xs btn-outline-info" id="tmBtnRecommended" disabled>Set Recommended</button>
                <button type="button" class="btn btn-xs btn-danger" id="tmBtnRemove" disabled><i class="fas fa-trash me-1"></i>Remove</button>
            </div>
        </div>
        <div class="card-body p-2 overflow-hidden">
            <table id="tmRows" class="table table-striped table-compact w-100"></table>
        </div>
    </div>
</div>

<!-- ===== Modal Apply ===== -->
<div class="modal fade" id="tmApplyModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Apply course ke sel terpilih</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-secondary py-2 small mb-3" id="amSummary"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label for="amGroup" class="form-label fw-medium">Course Group (opsional)</label>
                        <select id="amGroup" class="form-select"></select>
                        <div class="form-text">Isi group disalin (snapshot); perubahan group nanti tidak mengubah dokumen ini.</div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-medium d-block">Requirement</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="amReq" id="amReqM" value="Mandatory" checked />
                            <label class="form-check-label" for="amReqM">Mandatory</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="amReq" id="amReqR" value="Recommended" />
                            <label class="form-check-label" for="amReqR">Recommended</label>
                        </div>
                    </div>
                </div>

                <label class="form-label fw-medium">
                    Course tambahan (opsional)
                    <span class="badge bg-primary ms-1" id="amCount">0</span>
                </label>
                <input type="search" id="amSearch" class="form-control form-control-sm mb-2"
                       placeholder="Search course code / name..." autocomplete="off" />
                <div id="amCourseList" class="border rounded" style="max-height: 300px; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="amApply"><i class="fas fa-check me-1"></i>Apply</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        window.tmDetailCfg = {

            matrixId: @matrixId,

            urls: {

                getDetail: '@Url.Action("GetDetail", "TrainingMatrix")',

                apply: '@Url.Action("Apply", "TrainingMatrix")',

                removeRows: '@Url.Action("RemoveRows", "TrainingMatrix")',

                setRequirement: '@Url.Action("SetRequirement", "TrainingMatrix")',

                remove: '@Url.Action("Delete", "TrainingMatrix")',

                transition: '@Url.Action("Transition", "TrainingMatrix")',

                index: '@Url.Action("Index", "TrainingMatrix")',

                crCreate: '@Url.Action("Create", "MatrixChangeRequest")',

                crDetail: '@Url.Action("Detail", "MatrixChangeRequest")',

                groups: '@Url.Action("GetList", "CourseGroup")',

                courseOptions: '@Url.Action("GetCourseOptions", "CourseGroup")'

            }

        };

    </script>

    <script src="~/js/training-matrix-detail.js" asp-append-version="true"></script>

}
