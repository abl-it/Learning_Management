@{
    ViewData["Title"] = "Training Matrix";
    var canEdit = ViewData["CanEdit"] is true;
}

<div class="container-fluid">

    <div class="row justify-content-between align-items-center mb-4">
        <div class="col-12 col-md-auto">
            <h4 class="mb-0 fw-medium">
                <i class="fa-solid fa-table-cells me-2"></i>Training Matrix
            </h4>
            <div class="text-muted small">
                Satu dokumen per Department: Sub Department × Layer (1-3) × Course.
            </div>
        </div>
        <div class="col-12 col-md-auto mt-2 mt-md-0">
            <span id="tmSummary" class="text-muted small"></span>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="card card-compact">
        <div class="card-body p-2">
            <div class="table-responsive" style="overflow-y:hidden">
                <table id="tmTable" class="table table-striped table-compact w-100" style="min-width:760px"></table>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        window.tmIndexCfg = {

            canEdit: @(canEdit ? "true" : "false"),

            urls: {

                getList: '@Url.Action("GetList", "TrainingMatrix")',

                create: '@Url.Action("Create", "TrainingMatrix")',

                remove: '@Url.Action("Delete", "TrainingMatrix")',

                detail: '@Url.Action("Detail", "TrainingMatrix")',

                changeRequest: '@Url.Action("Detail", "MatrixChangeRequest")'

            }

        };

    </script>

    <script src="~/js/training-matrix.js" asp-append-version="true"></script>

}
