@{
    ViewData["Title"] = "Not Authorized";
}

<div class="container mt-5">
    <div class="alert alert-danger" role="alert">
        <div class="text-center">
            <i class="bi bi-exclamation-circle" style="font-size: 3rem; color: #dc3545;"></i>
            <h2 class="mt-3">Access Denied</h2>
            <p class="mt-3 text-muted">
                Anda tidak memiliki izin untuk mengakses halaman ini.
            </p>
            <p>
                <strong>Status:</strong> Not Authorized (403)
            </p>
            <a href="/" class="btn btn-primary mt-3">
                <i class="bi bi-house-door me-2"></i>Kembali ke Home
            </a>
        </div>
    </div>
</div>
