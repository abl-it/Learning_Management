@using Training.Models.Dtos
@model MetricsCardDto

<div class="card h-100 border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
                <small class="text-muted d-block mb-2">@Model.Title</small>
                <h3 class="mb-2 text-dark">
                    @Model.Value.ToString("F1")@Model.Unit
                </h3>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <small class="text-muted d-block">@Model.Description</small>
                }
                @if (Model.ChangeFromPrevious.HasValue)
                {
                    <small class="@(Model.ChangeFromPrevious >= 0 ? "text-success" : "text-danger")">
                        @(Model.ChangeFromPrevious >= 0 ? "+" : "")@Model.ChangeFromPrevious.Value.ToString("F1")%
                    </small>
                }
            </div>
            <div class="ms-2">
                <i class="bi @Model.IconClass fs-2 text-@Model.BadgeStyle opacity-50"></i>
            </div>
        </div>
    </div>
</div>
