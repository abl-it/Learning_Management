@* 
    Modal "Master Course" (VIEW ONLY) - dipakai bersama oleh Training Plan & Training Event Create.
    Pemakaian:
      1. Letakkan <partial name="_CourseViewerModal" /> di view (di luar <form>).
      2. Tambahkan link/tombol: data-bs-toggle="modal" data-bs-target="#courseViewerModal"
      3. Di @section Scripts tambahkan: <script src="~/js/course-viewer.js" asp-append-version="true"></script>
    Data diambil dari Master/GetCourses (terbuka untuk semua user login).
*@
@inject Training.Services.IServices.ICategoryService CategoryService
@{
    var cvCategories = await CategoryService.GetAllCategoriesAsync();
}

<div class="modal fade" id="courseViewerModal" tabindex="-1" aria-labelledby="courseViewerModalLabel" aria-hidden="true"
     data-url="@Url.Action("GetCourses", "Master")">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0" id="courseViewerModalLabel">
                    <i class="fas fa-book me-2 text-primary"></i>Master Course
                    <span class="badge bg-secondary ms-2"><i class="fas fa-eye me-1"></i>View Only</span>
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row spacing-sm align-items-end mb-3">
                    <div class="col-xl-3 col-lg-4 col-md-5 col-sm-6 col-12">
                        <label for="cvCategoryFilter" class="form-label text-xs fw-medium mb-1">Category</label>
                        <select class="form-select form-select-xs" id="cvCategoryFilter">
                            <option value="All">All Categories</option>
                            @foreach (var c in cvCategories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                        <label for="cvStatusFilter" class="form-label text-xs fw-medium mb-1">Status</label>
                        <select class="form-select form-select-xs" id="cvStatusFilter">
                            <option value="">All Status</option>
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>
                    <div class="col-xl-1 col-lg-2 col-md-3 col-sm-6 col-12">
                        <button type="button" class="btn btn-outline-secondary btn-xs w-100" id="cvClearFilters">
                            <i class="fas fa-times me-1"></i>Clear
                        </button>
                    </div>
                </div>

                <table id="cvTable" class="table table-striped table-compact" style="width:100%">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Duration</th>
                            <th>T.Provider</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                </table>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-xs" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Close
                </button>
            </div>
        </div>
    </div>
</div>
