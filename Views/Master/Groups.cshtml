@model GroupVM

@{
    ViewData["Title"] = "Groups";
}
<style>
    .table-compact thead th {
        background-color: #343a40 !important; /* Dark gray */
        color: white !important;
        border-bottom: 2px solid #495057 !important;
    }
    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .action-buttons .btn-xs {
            padding: 0.2rem 0.4rem;
            font-size: 0.7rem;
        }
        /* Hide text on very small screens, keep icon */
        .action-buttons .btn-xs {
            font-size: 0;
        }

            .action-buttons .btn-xs i {
                font-size: 0.7rem;
            }
    }
</style>
<div class="container-fluid">
    <!-- Compact Header -->

    <div class="row justify-content-between align-items-center mb-5">

        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-auto">
                <h4 class="mb-0 fw-medium">
                    <i class="fas fa-layer-group me-2 text-primary"></i>Groups
                </h4>
            </div>

            <div class="col-12 col-md-auto ms-md-auto d-flex flex-column flex-md-row gap-2 justify-content-md-end">
                <a class="btn btn-sm btn-success" href="javascript:void(0);"
                   onclick="Add()">Add Group</a>
                @* <button class="btn btn-secondary btn-sm px-4 w-100 w-md-auto">Cancel</button> *@
                @* <button class="btn btn-success btn-sm px-4 w-100 w-md-auto" style="min-width: 175px;">Update Period</button> *@
            </div>
        </div>
    </div>

    <!-- Compact Filter Panel -->
    <div class="card card-compact mb-3">
        <div class="card-header">
            <h6 class="mb-0 fw-medium">
                <i class="fas fa-filter me-2"></i>Filters
            </h6>
        </div>
        <div class="card-body">
            <div class="row spacing-sm align-items-end">
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                    <label for="companyFilter" class="form-label text-xs fw-medium mb-1">Company</label>
                    <select class="form-select form-select-xs" id="companyFilter">
                        @foreach (var item in Model.Companies)
                        {
                            <option value="@item.CoCode">@item.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="col-xl-1 col-lg-1 col-md-6 col-sm-6 col-12">
                    <button type="button" class="btn btn-outline-secondary btn-xs w-100" id="clearFilters">
                        <i class="fas fa-times me-1"></i>Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Compact DataTable -->
    <div class="card card-compact mb-5">
        <div class="card-body p-2">
            <!-- Remove padding to maximize space -->
            <table id="dTable" class="table table-striped table-compact" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Group</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0" id="title">
                    <i class="fas fa-plus-circle me-1"></i>Modal Title
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-3">
                <form id="formModal">
                    <div id="validation-error" class="alert alert-danger d-none text-xs py-2"></div>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-hashtag me-1"></i>ID
                            </label>
                            <input type="text" id="id-a" class="form-control form-control-xs" readonly>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fa-solid fa-layer-group me-1"></i>COMPANY *
                            </label>
                            <select id="company-a" class="form-select form-select-xs" required>
                                @foreach (var item in Model.Companies)
                                {
                                    <option value="@item.CoCode">@item.CompanyName</option>
                                }
                            </select>
                            @* <input type="text" id="company-a" class="form-control form-control-xs" required placeholder="Enter Company"> *@
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fa-solid fa-layer-group me-1"></i>GROUP *
                            </label>
                            <input type="text" id="group-a" class="form-control form-control-xs" required placeholder="Enter Group">
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-info-circle me-1"></i>DESCRIPTION *
                            </label>
                            <textarea id="description-a" class="form-control form-control-xs" rows="2" required placeholder="Enter description..."></textarea>
                        </div>

                        <!-- Enhanced Active Toggle Switch -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center py-2 px-3 bg-light rounded border">
                                <label class="form-label text-xs fw-medium mb-0">
                                    <i class="fas fa-power-off me-1 text-success"></i>STATUS
                                </label>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" id="isActive-a" checked>
                                    <label class="form-check-label text-xs fw-bold" for="isActive-a" id="activeLabel">
                                        Active
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" id="btn-add" class="btn btn-success btn-xs">
                    <i class="fas fa-plus me-1"></i>Add
                </button>
                <button type="button" id="btn-edit" class="btn btn-primary btn-xs">
                    <i class="fas fa-save me-1"></i>Update
                </button>
                <button type="button" class="btn btn-secondary btn-xs" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        //const antiForgeryToken = '@(ViewBag.AntiForgeryToken ?? "")';

        let dTable;

        $(document).ready(function() {
            // Initialize compact DataTable
             dTable = $('#dTable').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                pageLength: 5, // Show more rows since they're smaller
                lengthMenu: [[5, 25, 50, 100, 200], [5, 25, 50, 100, 200]],
                // ✅ Use columnDefs for better width control
                    columnDefs: [
                            {
                                targets: 1, // Name column (0-indexed)
                                width: "25px",
                                className: "text-left"
                            },
                        {
                            targets: 2, // Name column (0-indexed)
                            width: "50px",
                            className: "text-left"
                        },
                        {
                            targets: 3, // Description column
                            width: "90px"
                        }
                    ],
                ajax: {
                    url: '@Url.Action("GetGroups", "Master")',
                    type: 'POST',
                    data: function(d) {
                        d.companyFilter = $('#companyFilter').val();
                    }
                },
                columns: [
                    {
                        data: 'groupId',
                        name: 'Id',
                        responsivePriority: 1,
                        className: 'text-center fw-medium',
                        width: '25px'
                    },
                    {
                        data: 'groupCode',
                        name: 'Name',
                        responsivePriority: 1,
                        width: '50px'
                    },
                    {
                        data: 'description',
                        name: 'Description',
                        responsivePriority: 3,
                        className: 'text-center',
                        width: '90px',

                    },
                    {
                        data: 'isActive',
                        name: 'IsActive',
                        responsivePriority: 2,
                        className: 'text-center text-sm',
                        width: '25px',
                        render: function(data, type, row) {
                            if (data == 1) {
                                return '<span class="badge bg-success">Active</span>';
                            } else {
                                return '<span class="badge bg-secondary">Inactive</span>';
                            }
                        }

                    },
                    {
                        data: null, // No data binding needed
                        name: 'Actions',
                        orderable: false, // Disable sorting
                        searchable: false, // Disable searching
                        responsivePriority: 1, // Always visible
                        className: 'text-center action-buttons',
                        width: '70px', // Smaller width for single button
                        render: function(data, type, row) {
                            return `
                                <button type="button" class="btn btn-outline-primary btn-xs edit-btn" data-id="${row.groupId}" title="Edit Group">
                                    <i class="fas fa-edit me-1"></i>Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-xs delete-btn" 
                                        data-id="${row.groupId}"
                                        data-name="${row.groupCode}"
                                        data-desc="${row.description}"
                                    title="Delete Group">
                                    <i class="fas fa-trash me-1"></i>Del
                                </button>
                            `;
                        }
                    }

                ],
                order: [[0, 'asc']],
                language: {
                    processing: '<i class="fas fa-spinner fa-spin me-2"></i>Loading...',
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_',
                    info: '_START_-_END_ of _TOTAL_',
                    infoEmpty: 'No groups found',
                    infoFiltered: '(filtered from _MAX_)',
                    zeroRecords: 'No matching groups found',
                    paginate: {
                        first: '<i class="fas fa-angle-double-left"></i>',
                        previous: '<i class="fas fa-angle-left"></i>',
                        next: '<i class="fas fa-angle-right"></i>',
                        last: '<i class="fas fa-angle-double-right"></i>'
                    }
                },
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                     '<"row"<"col-sm-12"tr>>' +
                     '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                drawCallback: function() {
                    // Add hover effects and animations
                    $(this).find('tbody tr').hover(
                        function() { $(this).addClass('table-hover-row'); },
                        function() { $(this).removeClass('table-hover-row'); }
                    );
                }
            });

            // Event handlers with improved UX
                $('#clearFilters').on('click', function() {
                    //$('#companyFilter').val('0');
                    // Set selected index to 0 (first option)
                    $('#companyFilter').prop('selectedIndex', 0);

                    const btn = $(this);
                    btn.html('<i class="fas fa-spinner fa-spin me-1"></i>Clearing...');
                    btn.prop('disabled', true);

                    dTable.ajax.reload(function() {
                        btn.html('<i class="fas fa-times me-1"></i>Clear');
                        btn.prop('disabled', false);
                    });
                });

            // Auto-apply filters with debouncing
            let filterTimeout;
            $('#companyFilter').on('change', function() {
                clearTimeout(filterTimeout);
                // Show loading indicator
                const filterBtn = $(this);
                filterBtn.prop('disabled', true);

                filterTimeout = setTimeout(() => {
                    dTable.ajax.reload(function() {
                        filterBtn.prop('disabled', false);
                    });
                }, 300);
            });

        // Handle Edit button clicks========================================================================
        $('#dTable').on('click', '.edit-btn', function(e) {
            e.preventDefault();
            clearError();
            propSetting('edit');

            const groupId = $(this).data('id');


            // Get the row data
            var table = $('#dTable').DataTable();
            var row = $(this).closest('tr');
            var data = table.row(row).data();

            // Populate the form with existing data
            $('#id-a').val(groupId);
            $('#group-a').val(data.groupCode);
            $('#description-a').val(data.description);
            $('#company-a').val(data.coCode);
            $('#isActive-a').prop('checked', data.isActive == 1);

            // Set modal title
            $('#title').text('Edit Group');

            // Show Edit button and hide Add button
            $('#btn-edit').show();
            $('#btn-add').hide();

            // Show modal
            let modal = new bootstrap.Modal(document.getElementById('myModal'), {});
            modal.show();
        });
        //------------------------------------------------------------------------------
        // Handle Delete button clicks========================================================================
        $('#dTable').on('click', '.delete-btn', function(e) {
            e.preventDefault();
            
            const groupId = $(this).data('id');
            // Get the row data
            let group = $(this).data('name');
            let description = $(this).data('desc');

            Swal.fire({
                 title: "Are You Sure ?",
                 html: `
                     <p>Delete This Group ?</p>
                     <p class="text-danger"><strong>${group}</strong> ( <strong>${description} )</strong></p>

                 `,
                 icon: "warning",
                 showCancelButton: true,
                 confirmButtonColor: "#3085d6",
                 cancelButtonColor: "#d33",
                 confirmButtonText: "Yes, delete!",
                 cancelButtonText: "Cancel",
                 focusConfirm: true
             }).then((result) => {
                 if (result.isConfirmed) {
                     deleteGroup(groupId);
                 }
             });
            
        });
        //------------------------------------------------------------------------------


        
        // Handle Add button click========================================================================
        $('#btn-add').on('click', function() {
            if (!validateForm()) return;

            clearError();
            const formData = {
                GroupCode: $('#group-a').val().trim(),
                Description: $('#description-a').val().trim(),
                CoCode: $('#company-a').val().trim(),
                IsActive: $('#isActive-a').is(':checked') ? 1 : 0
            };

                 // 🔍 DEBUG: Check what we're sending
                console.log('FormData being sent:', formData);
                console.log('JSON string being sent:', JSON.stringify(formData));
            
            $.ajax({
                url: '@Url.Action("AddGroup", "Master")',
                type: 'POST',
                data: JSON.stringify(formData),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                beforeSend: function() {
                    // Show loading state
                    $('#btn-add').prop('disabled', true).html(
                        '<i class="fas fa-spinner fa-spin me-1"></i>Adding...'
                    );
                },
                success: function(response) {
                    console.log('Add response:', response);
                    if (response.success) {
                        toastr.success(response.message || 'Group added successfully!');
                        $('#myModal').modal('hide');
                        dTable.ajax.reload(); // Refresh the DataTable
                    } else {
                        toastr.error(response.message || 'Failed to add group');
                        if (response.errors) {
                            showError(response.errors.join(', '));
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Add error:', error);
                    console.error('Response:', xhr.responseText);

                    let errorMessage = 'An error occurred while adding the group';
                    try {
                        const errorResponse = JSON.parse(xhr.responseText);
                        if (errorResponse.message) {
                            errorMessage = errorResponse.message;
                        }
                    } catch (e) {
                        // Use default message
                    }

                    toastr.error(errorMessage);
                },
                complete: function() {
                    // Reset button state
                    $('#btn-add').prop('disabled', false).html(
                        '<i class="fas fa-plus me-1"></i>Add'
                    );
                }
            });

        });
        //-----------------------------------------------------------------------------
        // Handle Edit button click
        $('#btn-edit').on('click', function() {
            if (!validateForm()) return;

            clearError();
            const formData = {
                GroupId: $('#id-a').val(),
                GroupCode: $('#group-a').val().trim(),
                Description: $('#description-a').val().trim(),
                CoCode: $('#company-a').val().trim(),
                IsActive: $('#isActive-a').is(':checked') ? 1 : 0
            };

            console.log('Updating category:', formData);

            $.ajax({
                url: '@Url.Action("UpdateGroup", "Master")',
                type: 'POST',
                data: JSON.stringify(formData),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                beforeSend: function() {
                    // Show loading state
                    $('#btn-add').prop('disabled', true).html(
                        '<i class="fas fa-spinner fa-spin me-1"></i>Adding...'
                    );
                },
                success: function(response) {
                    console.log('Update response:', response);
                    if (response.success) {
                        toastr.success(response.message || 'Group updated successfully!');
                        $('#myModal').modal('hide');
                        dTable.ajax.reload(); // Refresh the DataTable
                    } else {
                        toastr.error(response.message || 'Failed to update group');
                        if (response.errors) {
                            showError(response.errors.join(', '));
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Update error:', error);
                    console.error('Response:', xhr.responseText);

                    let errorMessage = 'An error occurred while updating the group';
                    try {
                        const errorResponse = JSON.parse(xhr.responseText);
                        if (errorResponse.message) {
                            errorMessage = errorResponse.message;
                        }
                    } catch (e) {
                        // Use default message
                    }

                    toastr.error(errorMessage);
                },
                complete: function() {
                    // Reset button state
                    $('#btn-edit').prop('disabled', false).html(
                        '<i class="fas fa-plus me-1"></i>Add'
                    );
                }
            });
        });
        //----------------------------------------------------------------------------------------

        });// end ready
        

        //ADD Data ===================================================================================
            function Add(){
                // Reset form fields
                document.getElementById('formModal').reset();
                propSetting('add');
                clearError();
                // Set modal title
                document.getElementById('title').textContent = "Add Group";

                // Show the Add button and hide the Edit button
                document.getElementById('btn-add').style.display = "inline-block";
                document.getElementById('btn-edit').style.display = "none";

                // Open the modal
                let modal = new bootstrap.Modal(document.getElementById('myModal'), {});
                modal.show();
            }
        //--------------------------------------------------------------------------------------------
        // Delete Group Function ========================================================================
        function deleteGroup(groupId) {
            //const id = parseInt(groupId);

            $.ajax({
                    url: '@Url.Action("DeleteGroup", "Master")',
                    type: 'POST',
                    data: JSON.stringify(groupId), // Send as number
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    beforeSend: function() {
                        console.log('Sending delete request for ID:', groupId);
                    },
                success: function(response) {
                    if (response.success) {
                        toastr.success(response.message || 'Group deleted successfully!');
                        dTable.ajax.reload();
                    } else {
                        toastr.error(response.message || 'Failed to delete group');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error:', error);
                    toastr.error('An error occurred while deleting the group');
                }
            });
        }
        //--------------------------------------------------------------------------------------------
        //Validate=======================================================================================
        function validateForm() {
            var group = $('#group-a').val().trim();
            var description = $('#description-a').val().trim();
            
            $('#validation-error').addClass('d-none').text('');

            if (!group) {
                $('#validation-error').removeClass('d-none').text('Group Code is required');
                $('#name-a').focus();
                return false;
            }

            if (!description) {
                $('#validation-error').removeClass('d-none').text('Course Description is required');
                $('#description-a').focus();
                return false;
            }

            // if (name.length < 3) {
            //     $('#validation-error').removeClass('d-none').text('Category Name must be at least 3 characters..!');
            //     $('#name-a').focus();
            //     return false;
            // }

            return true;

        }
        //-----------------------------------------------------------------------------------------------------------------------

        //Properties Setting============================================================================
        function propSetting(mode)
        {
            if (mode === 'add') {
                $('#id-a').prop('readonly', true);
                $('#group-a').prop('disabled', false);
                $('#company-a').prop('disabled', false);
            } else if (mode === 'edit') {
                $('#id-a').prop('readonly', true);
                $('#group-a').prop('disabled', true);
                $('#company-a').prop('disabled', true);
            }
        }
        //----------------------------------------------------------------------------------------------
    </script>

    @*  <!-- Hidden form for anti-forgery token -->
    <form method="post" asp-controller="Employee" asp-action="GetEmployees" style="display:none">
        @Html.AntiForgeryToken()
    </form> *@
}
