@model UnitVM

@{
    ViewData["Title"] = "Units";
}
<style>
    #courseTable th:nth-child(3),
    #courseTable td:nth-child(3) {
        width: 200px !important;
        max-width: 200px !important;
        min-width: 150px !important;
        word-wrap: break-word;
        white-space: normal;
    }

    #courseTable {
        table-layout: auto !important;
    }
</style>
<div class="container-fluid">
    <!-- Compact Header -->
    <div class="row justify-content-between align-items-center mb-5">

        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-auto">
                <h4 class="mb-0 fw-medium">
                    <i class="fa-brands fa-uniregistry text-primary me-2"></i>Units
                </h4>
            </div>

            <div class="col-12 col-md-auto ms-md-auto d-flex flex-column flex-md-row gap-2 justify-content-md-end">
                <a class="btn btn-sm btn-success" href="javascript:void(0);"
                   onclick="Add()">Add Unit</a>
                @* <button class="btn btn-secondary btn-sm px-4 w-100 w-md-auto">Cancel</button> *@
                @* <button class="btn btn-success btn-sm px-4 w-100 w-md-auto" style="min-width: 175px;">Update Period</button> *@
            </div>
        </div>
    </div>

    <!-- Compact Filter Panel -->
    <div class="card card-compact mb-3">
        <div class="card-header">
            <h6 class="mb-0 fw-medium">
                <i class="fas fa-filter me-2"></i>Filters
            </h6>
        </div>
        <div class="card-body">
            <div class="row spacing-sm align-items-end">
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                    <label for="companyFilter" class="form-label text-xs fw-medium mb-1">Company</label>
                    <select class="form-select form-select-xs" id="companyFilter">
                        @foreach (var item in Model.Companies)
                        {
                            <option value="@item.CoCode">@item.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                    <label for="groupFilter" class="form-label text-xs fw-medium mb-1">Group</label>
                    <select class="form-select form-select-xs" id="groupFilter">
                        <option value="0">All Group</option>
                        @foreach (var item in Model.Groups)
                        {
                            <option value="@item.GroupId">@item.GroupCode</option>
                        }
                    </select>
                </div>
                <div class="col-xl-1 col-lg-1 col-md-6 col-sm-6 col-12">
                    <button type="button" class="btn btn-outline-secondary btn-xs w-100" id="clearFilters">
                        <i class="fas fa-times me-1"></i>Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Compact DataTable -->
    <div class="card card-compact">
        <div class="card-body p-2">
            <!-- Remove padding to maximize space -->
            <table id="dTable" class="table table-striped table-compact" style="width:100%">
                <thead>
                    <tr>
                        <th>Group</th>
                        <th>ID</th>
                        <th>CODE</th>
                        <th>NAME</th>
                        <th>COMPANY</th>
                        <th>Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0" id="title">
                    <i class="fas fa-plus-circle me-1"></i>Modal Title
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-3">
                <form id="formModal">
                    <div id="validation-error" class="alert alert-danger d-none text-xs py-2"></div>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-hashtag me-1"></i>ID
                            </label>
                            <input type="text" id="id-a" class="form-control form-control-xs" readonly>
                        </div>
                        
                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fa-solid fa-building me-1"></i>COMPANY
                            </label>
                            <input type="text" id="coCode-a" class="form-control form-control-xs" readonly>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-tags me-1"></i>GROUP *
                            </label>
                            <select class="form-control form-control-xs" id="group-a" name="group-a">
                                @foreach (var item in Model.Groups)
                                {
                                    if (item.GroupId != 0)
                                    {
                                        <option value="@item.GroupId">@item.GroupCode</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-tag me-1"></i>CODE *
                            </label>
                            <input type="text" id="code-a" class="form-control form-control-xs" required placeholder="Enter code">
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-info-circle me-1"></i>NAME *
                            </label>
                            <input type="text" id="name-a" class="form-control form-control-xs" required placeholder="Enter name">
                        </div>

                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" id="btn-add" class="btn btn-success btn-xs">
                    <i class="fas fa-plus me-1"></i>Add
                </button>
                <button type="button" id="btn-edit" class="btn btn-primary btn-xs">
                    <i class="fas fa-save me-1"></i>Update
                </button>
                <button type="button" class="btn btn-secondary btn-xs" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
            const antiForgeryToken = '@(ViewBag.AntiForgeryToken ?? "")';

            let dTable;

        $(document).ready(function() {
            // Initialize compact DataTable
                dTable = $('#dTable').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                    autoWidth: false,
                pageLength: 10, // Show more rows since they're smaller
                lengthMenu: [[10, 25, 50, 100, 200], [10, 25, 50, 100, 200]],
                    // ✅ Use columnDefs for better width control
                        columnDefs: [
                                {
                                    targets: 0, // Name column (0-indexed)
                                    width: "25px",
                                    className: "text-left"
                                },
                            {
                                targets: 1, // Name column (0-indexed)
                                width: "5px",
                                className: "text-center"
                            },
                            {
                                targets: 2, // Name column (0-indexed)
                                width: "20px",
                                className: "text-left"
                            },
                            {
                                targets: 4, // Name column (0-indexed)
                                width: "100px",
                                className: "text-left"
                            }
                        ],
                ajax: {
                    url: '@Url.Action("GetUnits", "Master")',
                    type: 'POST',
                    data: function(d) {
                        d.companyFilter = $('#companyFilter').val();
                        d.groupFilter = $('#groupFilter').val();
                    }

                },
                columns: [
                    {
                        data: 'groupCode',
                        name: 'Group',
                        responsivePriority: 1000,

                    },
                    {
                        data: 'unitId',
                        name: 'Id',
                        responsivePriority: 1000,
                    },
                    {
                        data: 'unitCode',
                        name: 'Code',
                        responsivePriority: 1,

                    },
                    
                    {
                            data: 'unitName',
                            name: 'Name',
                            responsivePriority: 1,
                            className: 'text-left',
                            width: '100px',
                            render: function(data, type, row) {
                                if (type === 'display') {
                                    // ✅ Truncate long descriptions and add tooltip
                                    var maxLength = 90; // Adjust as needed
                                    var truncated = data && data.length > maxLength ?
                                        data.substring(0, maxLength) + '...' : data;

                                    return `<span title="${data || ''}" class="description-cell">${truncated || ''}</span>`;
                                }
                                return data;
                            }

                    },
                    {
                        data: 'coCode',
                        name: 'Company',
                        responsivePriority: 1,
                    },
                    {
                        data: null, // No data binding needed
                        name: 'Actions',
                        orderable: false, // Disable sorting
                        searchable: false, // Disable searching
                        responsivePriority: 1, // Always visible
                        className: 'text-center action-buttons',
                        width: '50px', // Smaller width for single button
                        render: function(data, type, row) {
                            return `
                                <button type="button" class="btn btn-outline-primary btn-xs edit-btn" data-id="${row.unitId}" title="Edit Unit">
                                    <i class="fas fa-edit me-1"></i>Edit
                                </button>
                            `;
                        }
                    }

                ],
                order: [[0, 'asc']],
                language: {
                    processing: '<i class="fas fa-spinner fa-spin me-2"></i>Loading...',
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_',
                    info: '_START_-_END_ of _TOTAL_',
                    infoEmpty: 'No units found',
                    infoFiltered: '(filtered from _MAX_)',
                    zeroRecords: 'No matching units found',
                    paginate: {
                        first: '<i class="fas fa-angle-double-left"></i>',
                        previous: '<i class="fas fa-angle-left"></i>',
                        next: '<i class="fas fa-angle-right"></i>',
                        last: '<i class="fas fa-angle-double-right"></i>'
                    }
                },
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                        '<"row"<"col-sm-12"tr>>' +
                        '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                drawCallback: function() {
                    // Add hover effects and animations
                    $(this).find('tbody tr').hover(
                        function() { $(this).addClass('table-hover-row'); },
                        function() { $(this).removeClass('table-hover-row'); }
                    );
                }
            });


            let filterTimeout;
            
            // Event handlers with improved UX

            // Load groups for initially selected company
            const initialCompany = $('#companyFilter').val();
            if (initialCompany) {
                loadGroupsByCompany(initialCompany, false); // false = don't reload table yet
            }

            // Handle Company Filter Change - CASCADE TO GROUP
            $('#companyFilter').on('change', function() {
                const companyCode = $(this).val();

                // Clear and disable group filter while loading
                $('#groupFilter').prop('disabled', true)
                                 .html('<option value="0">Loading groups...</option>');

                clearTimeout(filterTimeout);

                if (companyCode) {
                    loadGroupsByCompany(companyCode, true, 'filter'); // true = reload table after loading
                }
            });

            // Handle Group Filter Change
            $('#groupFilter').on('change', function() {
                clearTimeout(filterTimeout);
                const filterBtn = $(this);
                filterBtn.prop('disabled', true);

                filterTimeout = setTimeout(() => {
                    dTable.ajax.reload(function() {
                        filterBtn.prop('disabled', false);
                        toastr.success('Filter applied');
                    });
                }, 300);
            });

            // Updated Clear Filters - Reset to first company
            $('#clearFilters').on('click', function() {
                $('#companyFilter').prop('selectedIndex', 0); // Reset to first company
                $('#groupFilter').val('0');

                const btn = $(this);
                btn.html('<i class="fas fa-spinner fa-spin me-1"></i>Clearing...');
                btn.prop('disabled', true);

                // Load groups for the first company
                const firstCompany = $('#companyFilter').val();
                loadGroupsByCompany(firstCompany, false); // Load groups first

                // Then reload DataTable
                setTimeout(() => {
                    dTable.ajax.reload(function() {
                        btn.html('<i class="fas fa-times me-1"></i>Clear');
                        btn.prop('disabled', false);
                        toastr.success('Filters cleared');
                    });
                }, 300);
            });
        


            // Handle Edit button clicks========================================================================
            $('#dTable').on('click', '.edit-btn1', function(e) {
                e.preventDefault();
                clearError();
                propSetting('edit');

                const groupId = $(this).data('id');


                // Get the row data
                var table = $('#dTable').DataTable();
                var row = $(this).closest('tr');
                var data = table.row(row).data();

                // Populate the form with existing data
                $('#id-a').val(groupId);
                $('#coCode-a').val(data.coCode); // or data.companyCode')
                $('#group-a').val(data.groupId);
                $('#code-a').val(data.unitCode);
                $('#name-a').val(data.unitName);
                
                // Set modal title
                $('#title').text('Edit Unit');

                // Show Edit button and hide Add button
                $('#btn-edit').show();
                $('#btn-add').hide();

                // Show modal
                let modal = new bootstrap.Modal(document.getElementById('myModal'), {});
                modal.show();
            });

            // Handle Edit button clicks========================================================================
            $('#dTable').on('click', '.edit-btn', function(e) {
                e.preventDefault();
                clearError();


                const unitId = $(this).data('id');

                // Get the row data
                var table = $('#dTable').DataTable();
                var row = $(this).closest('tr');
                var data = table.row(row).data();

                // ✅ Get company code from the current filter or from data
                const currentCompany = $('#companyFilter').val();
                const companyName = $('#companyFilter option:selected').text();

                // Populate the form with existing data
                $('#id-a').val(unitId);
                $('#coCode-a').val(companyName); // ✅ Show company name

                // ✅ Load groups for this company first, then set the selected group
                loadGroupsForEdit(currentCompany, data.groupId);

                $('#code-a').val(data.unitCode);
                $('#name-a').val(data.unitName);

                // Set modal title
                $('#title').text('Edit Unit');

                // ✅ Call propSetting AFTER loading groups
                propSetting('edit');

                // Show Edit button and hide Add button
                $('#btn-edit').show();
                $('#btn-add').hide();

                // Show modal
                let modal = new bootstrap.Modal(document.getElementById('myModal'), {});
                modal.show();
            });

            //------------------------------------------------------------------------------



            // Handle Add button click========================================================================
            $('#btn-add').on('click', function() {
                if (!validateForm()) return;

                clearError();
                const formData = {
                    GroupId: $('#group-a').val().trim(),
                    UnitCode: $('#code-a').val().trim(),
                    UnitName: $('#name-a').val().trim(),
                };

                     // 🔍 DEBUG: Check what we're sending
                    console.log('FormData being sent:', formData);
                    console.log('JSON string being sent:', JSON.stringify(formData));

                $.ajax({
                    url: '@Url.Action("AddUnit", "Master")',
                    type: 'POST',
                    data: JSON.stringify(formData),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    beforeSend: function() {
                        // Show loading state
                        $('#btn-add').prop('disabled', true).html(
                            '<i class="fas fa-spinner fa-spin me-1"></i>Adding...'
                        );
                    },
                    success: function(response) {
                        console.log('Add response:', response);
                        if (response.success) {
                            toastr.success(response.message || 'Unit added successfully!');
                            $('#myModal').modal('hide');
                            dTable.ajax.reload(); // Refresh the DataTable
                        } else {
                            toastr.error(response.message || 'Failed to add Unit');
                            if (response.errors) {
                                showError(response.errors.join(', '));
                            }
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Add error:', error);
                        console.error('Response:', xhr.responseText);

                        let errorMessage = 'An error occurred while adding the group';
                        try {
                            const errorResponse = JSON.parse(xhr.responseText);
                            if (errorResponse.message) {
                                errorMessage = errorResponse.message;
                            }
                        } catch (e) {
                            // Use default message
                        }

                        toastr.error(errorMessage);
                    },
                    complete: function() {
                        // Reset button state
                        $('#btn-add').prop('disabled', false).html(
                            '<i class="fas fa-plus me-1"></i>Add'
                        );
                    }
                });

            });
            //-----------------------------------------------------------------------------
            // Handle Edit button click
            $('#btn-edit').on('click', function() {
                if (!validateForm()) return;

                clearError();
                const formData = {
                    UnitId: $('#id-a').val(),
                    GroupId: $('#group-a').val(),
                    UnitCode: $('#code-a').val().trim(),
                    UnitName: $('#name-a').val().trim()
                
                };

                console.log('Updating Unit:', formData);

                $.ajax({
                    url: '@Url.Action("UpdateUnit", "Master")',
                    type: 'POST',
                    data: JSON.stringify(formData),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    beforeSend: function() {
                        // Show loading state
                        $('#btn-edit').prop('disabled', true).html(
                            '<i class="fas fa-spinner fa-spin me-1"></i>Updating...'
                        );
                    },
                    success: function(response) {
                        console.log('Update response:', response);
                        if (response.success) {
                            toastr.success(response.message || 'Unit updated successfully!');
                            $('#myModal').modal('hide');
                            dTable.ajax.reload(); // Refresh the DataTable
                        } else {
                            toastr.error(response.message || 'Failed to update unit');
                            if (response.errors) {
                                showError(response.errors.join(', '));
                            }
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Update error:', error);
                        console.error('Response:', xhr.responseText);

                        let errorMessage = 'An error occurred while updating the unit';
                        try {
                            const errorResponse = JSON.parse(xhr.responseText);
                            if (errorResponse.message) {
                                errorMessage = errorResponse.message;
                            }
                        } catch (e) {
                            // Use default message
                        }

                        toastr.error(errorMessage);
                    },
                    complete: function() {
                        // Reset button state
                        $('#btn-edit').prop('disabled', false).html(
                            '<i class="fas fa-save me-1"></i>Update'
                        );
                        //document.getElementById('btn-edit').style.display = "inline-block";
                        //document.getElementById('btn-add').style.display = "none";
                    }
                });
            });
            //--------------------------------------------------------------------------------------------
        });
        //end-ready

        
        // Updated Load Groups by Company (with optional target parameter)
        function loadGroupsByCompany(companyCode, reloadTable = true, target = 'filter') {
            $.ajax({
                url: '@Url.Action("GetGroupsByCompany", "Master")',
                type: 'POST',
                data: { companyCode: companyCode },
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        // ✅ Update different dropdowns based on target
                        if (target === 'filter') {
                            updateGroupFilter(response.data);
                        } else if (target === 'modal') {
                            updateModalGroupDropdown(response.data);
                        }

                        // Auto-reload DataTable if requested
                        if (reloadTable) {
                            setTimeout(() => {
                                dTable.ajax.reload(function() {
                                    toastr.success('Filters applied');
                                });
                            }, 100);
                        }
                    } else {
                        toastr.error('Failed to load groups for selected company');
                        if (target === 'filter') {
                            updateGroupFilter([]);
                        } else if (target === 'modal') {
                            updateModalGroupDropdown([]);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading groups:', error);
                    toastr.error('Error loading groups');
                    if (target === 'filter') {
                        updateGroupFilter([]);
                    } else if (target === 'modal') {
                        updateModalGroupDropdown([]);
                    }
                }
            });
        }
        // Load Groups for Edit Mode
        function loadGroupsForEdit(companyCode, selectedGroupId) {
            // Show loading state
            $('#group-a').prop('disabled', true)
                         .html('<option value="">Loading groups...</option>');

            $.ajax({
                url: '@Url.Action("GetGroupsByCompany", "Master")',
                type: 'POST',
                data: { companyCode: companyCode },
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        let options = '';

                        if (response.data && response.data.length > 0) {
                            response.data.forEach(function(group) {
                                if (group.groupId !== 0) {
                                    // ✅ Set selected attribute for the current group
                                    const selected = group.groupId == selectedGroupId ? 'selected' : '';
                                    options += `<option value="${group.groupId}" ${selected}>${group.groupCode}</option>`;
                                }
                            });
                        }

                        $('#group-a').html(options)
                                    .prop('disabled', true); // ✅ Keep disabled for edit mode

                    } else {
                        toastr.error('Failed to load groups');
                        $('#group-a').html('<option value="">No groups available</option>')
                                    .prop('disabled', true);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading groups for edit:', error);
                    toastr.error('Error loading groups');
                    $('#group-a').html('<option value="">Error loading groups</option>')
                                .prop('disabled', true);
                }
            });
        }



        // Update Modal Group Dropdown
        function updateModalGroupDropdown(groups) {
            let options = '<option value="">Select Group</option>';

            if (groups && groups.length > 0) {
                groups.forEach(function(group) {
                    if (group.groupId !== 0) {
                        options += `<option value="${group.groupId}">${group.groupCode}</option>`;
                    }
                });
            }

            $('#group-a').html(options)
                        .prop('disabled', false);
        }

        // Update Group Filter Dropdown
        function updateGroupFilter(groups) {
            let options = '<option value="0">All Groups</option>';

            if (groups && groups.length > 0) {
                groups.forEach(function(group) {
                    options += `<option value="${group.groupId}">${group.groupCode}</option>`;
                });
            }

            $('#groupFilter').html(options)
                            .prop('disabled', false)
                            .val('0'); // Reset to "All Groups"
        }


        //ADD Data ===================================================================================
        function Add(){
            document.getElementById('formModal').reset();
            propSetting('add');
            clearError();

            const selectedCompanyCode = $('#companyFilter').val();
            const selectedCompanyName = $('#companyFilter option:selected').text();

            $('#coCode-a').val(selectedCompanyName); // atau selectedCompanyCode

            // ✅ Load groups for modal (don't reload table)
            loadGroupsByCompany(selectedCompanyCode, false, 'modal');

            document.getElementById('title').textContent = "Add Unit";
            document.getElementById('btn-add').style.display = "inline-block";
            document.getElementById('btn-edit').style.display = "none";

            let modal = new bootstrap.Modal(document.getElementById('myModal'), {});
            modal.show();
        }

        //--------------------------------------------------------------------------------------------
       
        //Validate=======================================================================================
        function validateForm() {
            var group = $('#group-a').val().trim();
            var code = $('#code-a').val().trim();
            var name = $('#name-a').val().trim();

            $('#validation-error').addClass('d-none').text('');

            if (!group) {
                $('#validation-error').removeClass('d-none').text('Group Code is required');
                $('#name-a').focus();
                return false;
            }

            if (!code) {
                $('#validation-error').removeClass('d-none').text('Unit Code is required');
                $('#code-a').focus();
                return false;
            }

            if (!name) {
                $('#validation-error').removeClass('d-none').text('Unit Name is required');
                $('#name-a').focus();
                return false;
            }

             if (name.length < 3) {
                 $('#validation-error').removeClass('d-none').text('Unit Name must be at least 3 characters..!');
                 $('#name-a').focus();
                 return false;
             }

            return true;

        }
        //-----------------------------------------------------------------------------------------------------------------------

        //Properties Setting============================================================================
        function propSetting(mode)
        {
            //if (mode === 'add') {
            //    $('#id-a').prop('readonly', true);
            //    $('#group-a').prop('disabled', false);
            //} else if (mode === 'edit') {
            //    $('#id-a').prop('readonly', true);
            //    $('#group-a').prop('disabled', true);
            //}

            if (mode === 'add') {
                $('#id-a').prop('readonly', true);
                $('#coCode-a').prop('readonly', true); // ✅ Company always readonly
                $('#group-a').prop('disabled', false); // ✅ Group enabled for add
            } else if (mode === 'edit') {
                $('#id-a').prop('readonly', true);
                $('#coCode-a').prop('readonly', true); // ✅ Company always readonly
                $('#group-a').prop('disabled', true); // ✅ Group disabled for edit
            }
        }
        //----------------------------------------------------------------------------------------------
    </script>
    <!-- Hidden form for anti-forgery token -->
