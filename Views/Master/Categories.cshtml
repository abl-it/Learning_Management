@model ProfileViewModel

@{
    ViewData["Title"] = "Categories";
}
<style>

  
    </style>
<div class="container-fluid">
    <!-- Compact Header -->

    <div class="row justify-content-between align-items-center mb-5">

        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-auto">
                <h4 class="mb-0 fw-medium">
                    <i class="fas fa-tags me-2 text-primary"></i>Categories
                </h4>
            </div>

            <div class="col-12 col-md-auto ms-md-auto d-flex flex-column flex-md-row gap-2 justify-content-md-end">
                <a class="btn btn-sm btn-success" href="javascript:void(0);"
                   onclick="Add()">Add Category</a>
                @* <button class="btn btn-secondary btn-sm px-4 w-100 w-md-auto">Cancel</button> *@
                @* <button class="btn btn-success btn-sm px-4 w-100 w-md-auto" style="min-width: 175px;">Update Period</button> *@
            </div>
        </div>
    </div>



    <!-- Compact DataTable -->
    <div class="card card-compact mb-5">
        <div class="card-body p-2">
            <!-- Remove padding to maximize space -->
            <table id="categoryTable" class="table table-striped table-compact" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Description</th>
                        <th>IsActive</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0" id="title">
                    <i class="fas fa-plus-circle me-1"></i>Modal Title
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-3">
                <form id="formModal">
                    <div id="validation-error" class="alert alert-danger d-none text-xs py-2"></div>

                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-hashtag me-1"></i>ID
                            </label>
                            <input type="text" id="id-a" class="form-control form-control-xs" readonly>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-tag me-1"></i>NAME *
                            </label>
                            <input type="text" id="name-a" class="form-control form-control-xs" required placeholder="Enter name">
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-code me-1"></i>CODE *
                            </label>
                            <input type="text" id="code-a" class="form-control form-control-xs" required placeholder="Enter code">
                        </div>

                        <div class="col-12">
                            <label class="form-label text-xs fw-medium mb-1">
                                <i class="fas fa-info-circle me-1"></i>DESCRIPTION
                            </label>
                            <textarea id="description-a" class="form-control form-control-xs" rows="2" placeholder="Enter description..."></textarea>
                        </div>

                        <!-- Enhanced Active Toggle Switch -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center py-2 px-3 bg-light rounded border">
                                <label class="form-label text-xs fw-medium mb-0">
                                    <i class="fas fa-power-off me-1 text-success"></i>STATUS
                                </label>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" id="isActive-a" checked>
                                    <label class="form-check-label text-xs fw-bold" for="isActive-a" id="activeLabel">
                                        Active
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" id="btn-add" class="btn btn-success btn-xs">
                    <i class="fas fa-plus me-1"></i>Add
                </button>
                <button type="button" id="btn-edit" class="btn btn-primary btn-xs">
                    <i class="fas fa-save me-1"></i>Update
                </button>
                <button type="button" class="btn btn-secondary btn-xs" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        //const antiForgeryToken = '@(ViewBag.AntiForgeryToken ?? "")';

        let categoryTable;

        $(document).ready(function() {
            // Initialize compact DataTable
             categoryTable = $('#categoryTable').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                pageLength: 5, // Show more rows since they're smaller
                lengthMenu: [[5, 25, 50, 100, 200], [5, 25, 50, 100, 200]],
                ajax: {
                    url: '@Url.Action("GetCategories", "Master")',
                    type: 'POST',

                },
                columns: [
                    {
                        data: 'categoryId',
                        name: 'Id',
                        responsivePriority: 1000,
                        className: 'text-center fw-medium',
                        width: '10px'
                    },
                    {
                        data: 'categoryName',
                        name: 'Name',
                        responsivePriority: 1,
                        width: '150px'
                    },
                    {
                        data: 'categoryCode',
                        name: 'Code',
                        responsivePriority: 2,
                        width: '25px'
                    },
                    {
                        data: 'description',
                        name: 'Description',
                        responsivePriority: 4,
                        className: 'text-center',
                        width: '90px',

                    },
                    {
                        data: 'isActive',
                        name: 'IsActive',
                        responsivePriority: 1,
                        className: 'text-center text-sm',
                        width: '25px',
                        render: function(data, type, row) {
                            if (data == 1) {
                                return '<span class="badge bg-success">Active</span>';
                            } else {
                                return '<span class="badge bg-secondary">Inactive</span>';
                            }
                        }
                    },
                    {
                        data: null, // No data binding needed
                        name: 'Actions',
                        orderable: false, // Disable sorting
                        searchable: false, // Disable searching
                        responsivePriority: 1, // Always visible
                        className: 'text-center action-buttons',
                        width: '50px', // Smaller width for single button
                        render: function(data, type, row) {
                            return `
                                <button type="button" class="btn btn-outline-primary btn-xs edit-btn" data-id="${row.categoryId}" title="Edit Category">
                                    <i class="fas fa-edit me-1"></i>Edit
                                </button>
                            `;
                        }
                    }

                ],
                order: [[0, 'asc']],
                language: {
                    processing: '<i class="fas fa-spinner fa-spin me-2"></i>Loading...',
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_',
                    info: '_START_-_END_ of _TOTAL_',
                    infoEmpty: 'No employees found',
                    infoFiltered: '(filtered from _MAX_)',
                    zeroRecords: 'No matching employees found',
                    paginate: {
                        first: '<i class="fas fa-angle-double-left"></i>',
                        previous: '<i class="fas fa-angle-left"></i>',
                        next: '<i class="fas fa-angle-right"></i>',
                        last: '<i class="fas fa-angle-double-right"></i>'
                    }
                },
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                     '<"row"<"col-sm-12"tr>>' +
                     '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                drawCallback: function() {
                    // Add hover effects and animations
                    $(this).find('tbody tr').hover(
                        function() { $(this).addClass('table-hover-row'); },
                        function() { $(this).removeClass('table-hover-row'); }
                    );
                }
            });

            // Handle Edit button clicks
            $('#categoryTable').on('click', '.edit-btn', function(e) {
                e.preventDefault();
                clearError();
                
                const categoryId = $(this).data('id');


                // Get the row data
                var table = $('#categoryTable').DataTable();
                var row = $(this).closest('tr');
                var data = table.row(row).data();

                // Populate the form with existing data
                $('#id-a').val(data.categoryId);
                $('#name-a').val(data.categoryName);
                $('#code-a').val(data.categoryCode);
                $('#description-a').val(data.description);
                $('#isActive-a').prop('checked', data.isActive == 1);

                // Set modal title
                $('#title').text('Edit Category');

                // Show Edit button and hide Add button
                $('#btn-edit').show();
                $('#btn-add').hide();

                // Show modal
                let modal = new bootstrap.Modal(document.getElementById('myModal'), {});
                modal.show();
            });

        // Handle Add button click
        $('#btn-add').on('click', function() {
            if (!validateForm()) return;

            clearError();

            const btn = $(this);
            const originalText = btn.html();
            btn.html('<i class="fas fa-spinner fa-spin me-1"></i>Saving...').prop('disabled', true);

            // Use form data instead of JSON
            var formData = {
                CategoryName: $('#name-a').val().trim(),
                CategoryCode: $('#code-a').val().trim(),
                Description: $('#description-a').val().trim(),
                IsActive: $('#isActive-a').is(':checked') ? 1 : 0,
                CreatedBy: @Model.profile.EmployeeCode.ToString(),
            };

            console.log('Adding category:', formData);

            $.ajax({
                url: '@Url.Action("CreateCategory", "Master")',
                type: 'POST',
                data: formData, // Send as form data instead of JSON
                // Remove contentType to let jQuery set it automatically
                success: function(response) {
                    if (response.success) {
                        $('#myModal').modal('hide');
                        categoryTable.ajax.reload();
                        showNotification('Category added successfully!', 'success');
                    } else {
                        showError(response.message || 'Error adding category');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', xhr.responseText);
                    showError('Error adding category: ' + error);
                },
                complete: function() {
                    btn.html(originalText).prop('disabled', false);
                }
            });
        });

        // Handle Edit button click
        $('#btn-edit').on('click', function() {
            if (!validateForm()) return;

            clearError();

            const btn = $(this);
            const originalText = btn.html();
            btn.html('<i class="fas fa-spinner fa-spin me-1"></i>Saving...').prop('disabled', true);

            // Use form data instead of JSON
            var formData = {
                CategoryId: $('#id-a').val(),
                CategoryName: $('#name-a').val().trim(),
                CategoryCode: $('#code-a').val().trim(),
                Description: $('#description-a').val().trim(),
                IsActive: $('#isActive-a').is(':checked') ? 1 : 0,
                CreatedBy: @Model.profile.EmployeeCode.ToString(),
            };

            console.log('Updating category:', formData);

            $.ajax({
                url: '@Url.Action("UpdateCategory", "Master")',
                type: 'POST',
                data: formData, // Send as form data instead of JSON
                // Remove contentType to let jQuery set it automatically
                success: function(response) {
                    if (response.success) {
                        $('#myModal').modal('hide');
                        categoryTable.ajax.reload();
                        showNotification('Category updated successfully!', 'success');
                    } else {
                        showError(response.message || 'Error adding category');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', xhr.responseText);
                    showError('Error adding category: ' + error);
                },
                complete: function() {
                    btn.html(originalText).prop('disabled', false);
                }
            });
        });

        


        });
        //end-ready

            //ADD Data ===================================================================================
            function Add(){
                // Reset form fields
                document.getElementById('formModal').reset();
                clearError();
                // Set modal title
                document.getElementById('title').textContent = "Add Category";

                // Show the Add button and hide the Edit button
                document.getElementById('btn-add').style.display = "inline-block";
                document.getElementById('btn-edit').style.display = "none";

                // Open the modal
                let modal = new bootstrap.Modal(document.getElementById('myModal'), {});
                modal.show();
            }

        //--------------------------------------------------------------------------------------------


        function validateForm() {
            var name = $('#name-a').val().trim();
            var code = $('#code-a').val().trim();

            $('#validation-error').addClass('d-none').text('');

            if (!name) {
                $('#validation-error').removeClass('d-none').text('Category Name is required');
                $('#name-a').focus();
                return false;
            }

            if (!code) {
                $('#validation-error').removeClass('d-none').text('Category Code is required');
                $('#code-a').focus();
                return false;
            }

            if (name.length < 3) {
                $('#validation-error').removeClass('d-none').text('Category Name must be at least 3 characters..!');
                $('#name-a').focus();
                return false;
            }

            return true;
        }

      


    </script>

    @*  <!-- Hidden form for anti-forgery token -->
    <form method="post" asp-controller="Employee" asp-action="GetEmployees" style="display:none">
        @Html.AntiForgeryToken()
    </form> *@
}
