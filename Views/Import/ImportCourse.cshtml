@{
    ViewData["Title"] = "Import Master Course";
}

<div class="container-fluid mt-4">
    <!-- ✅ HEADER WITH BACK BUTTON -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-0">
                    <i class="bi bi-file-earmark-excel text-primary"></i>
                    Import Master Course
                </h3>
            </div>
            <button class="btn btn-outline-secondary btn-sm" id="backBtn" onclick="goBack()">
                <i class="bi bi-arrow-left"></i> Back to Training
            </button>
        </div>
        <hr>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-excel"></i>
                        Import Master Course
                    </h5>
                </div>
                <div class="card-body">
                    <form id="importForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="courseFile" class="form-label">
                                <strong>Pilih File Excel</strong>
                            </label>
                            <input class="form-control form-control-lg" type="file"
                                   id="courseFile" name="file" accept=".xlsx,.xls" required>
                            <small class="form-text text-muted d-block mt-2">
                                Format: .xlsx atau .xls | Max: 5MB |
                                <a href="@Url.Content("~/Templates/Template_Master_Course.xlsx")" download class="link-primary">
                                    📥 Download Template
                                </a>
                            </small>
                        </div>

                        <div id="fileInfo" class="alert alert-info d-none" role="alert">
                            <strong>📄 File Selected:</strong> <span id="selectedFileName"></span>
                            <br>
                            <strong>📊 Size:</strong> <span id="selectedFileSize"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="reset" class="btn btn-outline-secondary" id="resetBtn">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Clear
                            </button>
                            <button type="submit" class="btn btn-primary btn-lg" id="importBtn">
                                <i class="bi bi-upload"></i>
                                Import
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div id="progressContainer" class="d-none mt-3">
                <div class="progress" style="height: 25px;">
                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" style="width: 100%">
                        Memproses...
                    </div>
                </div>
                <small class="text-muted mt-2 d-block">File sedang diproses, mohon tunggu...</small>
            </div>

            <div id="resultContainer" class="d-none mt-4"></div>
        </div>

        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-question-circle"></i>
                        Panduan Import
                    </h6>
                </div>
                <div class="card-body">
                    <h6 class="mb-3">📋 Kolom yang Diperlukan:</h6>
                    <ul class="small">
                        <li><strong>Category Code</strong> - TMG, TSK, TIS, TSF, TWI</li>
                        <li><strong>Course Name</strong> - Nama lengkap kursus</li>
                        <li><strong>Description</strong> - Deskripsi singkat</li>
                        <li><strong>Duration (Hours)</strong> - Jam training</li>
                        <li><strong>Trainer Type</strong> - Internal/External</li>
                        <li><strong>Is Active</strong> - Yes/No</li>
                    </ul>

                    <hr>

                    <h6 class="mb-3">⚙️ Auto-Generated:</h6>
                    <ul class="small">
                        <li><strong>Course Code:</strong> {CategoryCode}-{Sequence}</li>
                        <li><strong>Sequence:</strong> Auto increment per category</li>
                        <li><strong>Created Date:</strong> Waktu import</li>
                        <li><strong>Created By:</strong> Username Anda</li>
                    </ul>

                    <hr>

                    <h6 class="mb-3">✅ Tips:</h6>
                    <ul class="small">
                        <li>✓ Error di satu row tidak stop proses</li>
                        <li>✓ Semua row valid tetap di-import</li>
                        <li>✓ Error rows di-report dengan detail</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ✅ BASE PATH - Resolved server-side oleh ASP.NET Core (akurat untuk root maupun IIS subfolder deployment)
        // Sebelumnya pakai heuristic client-side yang menebak dari URL segment pertama - itu salah
        // karena segment pertama bisa jadi nama Controller (mis. "Import"), bukan IIS subfolder.
        window.APP_BASE_PATH = '@Url.Content("~/")';
        console.log('Base Path:', window.APP_BASE_PATH);

        // ✅ HELPER: Construct API URLs dengan base path
        function getApiUrl(endpoint) {
            return window.APP_BASE_PATH + 'api' + endpoint;
        }

        // ✅ BACK BUTTON: Navigate dengan base path
        function goBack() {
            // Cek apakah ada history
            if (window.history.length > 1) {
                window.history.back();
            } else {
                // Fallback: ke halaman training utama
                window.location.href = window.APP_BASE_PATH;
            }
        }

        $(document).ready(function() {
            $('#courseFile').on('change', function() {
                const file = this.files[0];
                if (file) {
                    $('#selectedFileName').text(file.name);
                    $('#selectedFileSize').text(formatFileSize(file.size));
                    $('#fileInfo').removeClass('d-none');
                } else {
                    $('#fileInfo').addClass('d-none');
                }
            });

            $('#importForm').on('submit', function(e) {
                e.preventDefault();
                importCourses();
            });

            $('#resetBtn').on('click', function() {
                $('#fileInfo').addClass('d-none');
                $('#resultContainer').addClass('d-none').html('');
            });
        });

        function importCourses() {
            const fileInput = document.getElementById('courseFile');
            const file = fileInput.files[0];

            if (!file) {
                Swal.fire('Warning', 'Pilih file terlebih dahulu', 'warning');
                return;
            }

            const maxSize = 5 * 1024 * 1024;
            if (file.size > maxSize) {
                Swal.fire('Error', 'File terlalu besar (max 5MB)', 'error');
                return;
            }

            $('#progressContainer').removeClass('d-none');
            $('#resultContainer').addClass('d-none').html('');
            $('#importBtn').prop('disabled', true);

            const formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: getApiUrl('/trainingcourse/import-courses'),
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function(response) {
                    displayResult(response);
                },
                error: function(xhr) {
                    const errorData = xhr.responseJSON || {};
                    Swal.fire('Error', errorData.message || 'Terjadi error saat import', 'error');
                },
                complete: function() {
                    $('#progressContainer').addClass('d-none');
                    $('#importBtn').prop('disabled', false);
                }
            });
        }

        function displayResult(response) {
            let html = '';

            if (response.successCount > 0) {
                html += `
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle"></i>
                                <strong>✅ Import Berhasil!</strong> ${response.successCount} course berhasil ditambah.
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        `;
            }

            if (response.errors && response.errors.length > 0) {
                html += `
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>⚠️ ${response.errorCount} Row Error:</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="50">Row</th>
                                            <th width="80">Category</th>
                                            <th>Course Name</th>
                                            <th>Error Message</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                response.errors.forEach(error => {
                    html += `
                                <tr>
                                    <td><span class="badge bg-danger">${error.rowNumber}</span></td>
                                    <td>${error.categoryCode || '-'}</td>
                                    <td><small>${error.courseName || '-'}</small></td>
                                    <td><small class="text-danger">${error.errorMessage}</small></td>
                                </tr>
                            `;
                });

                html += `
                                    </tbody>
                                </table>
                            </div>
                        `;
            }

            html += `
                        <div class="alert alert-info mt-3" role="alert">
                            <strong>📊 Summary:</strong>
                            <br>✅ Success: <span class="badge bg-success">${response.successCount}</span>
                            <br>❌ Error: <span class="badge bg-danger">${response.errorCount}</span>
                        </div>
                    `;

            $('#resultContainer').html(html).removeClass('d-none');

            $('html, body').animate({
                scrollTop: $('#resultContainer').offset().top - 100
            }, 500);
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
        }
    </script>
}
