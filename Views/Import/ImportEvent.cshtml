@{
    ViewData["Title"] = "Import Training Event & Participant";
}

<div class="container-fluid mt-4">
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-0">
                    <i class="bi bi-calendar-check text-primary"></i>
                    Import Training Event &amp; Participant
                </h3>
            </div>
            <button class="btn btn-outline-secondary btn-sm" id="backBtn" onclick="goBack()">
                <i class="bi bi-arrow-left"></i> Back to Training
            </button>
        </div>
        <hr>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-excel"></i>
                        Import Training Event &amp; Participant
                    </h5>
                </div>
                <div class="card-body">
                    <form id="importForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="eventFile" class="form-label">
                                <strong>Pilih File Excel</strong>
                            </label>
                            <input class="form-control form-control-lg" type="file"
                                   id="eventFile" name="file" accept=".xlsx,.xls" required>
                            <small class="form-text text-muted d-block mt-2">
                                Format: .xlsx atau .xls | Max: 5MB | 1 file berisi 2 sheet (Events + Participants) |
                                <a href="@Url.Content("~/Templates/Template_Training_Event.xlsx")" download class="link-primary">
                                    📥 Download Template
                                </a>
                            </small>
                        </div>

                        <div id="fileInfo" class="alert alert-info d-none" role="alert">
                            <strong>📄 File Selected:</strong> <span id="selectedFileName"></span>
                            <br>
                            <strong>📊 Size:</strong> <span id="selectedFileSize"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="reset" class="btn btn-outline-secondary" id="resetBtn">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Clear
                            </button>
                            <button type="submit" class="btn btn-primary btn-lg" id="importBtn">
                                <i class="bi bi-upload"></i>
                                Import
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div id="progressContainer" class="d-none mt-3">
                <div class="progress" style="height: 25px;">
                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" style="width: 100%">
                        Memproses...
                    </div>
                </div>
                <small class="text-muted mt-2 d-block">File sedang diproses, mohon tunggu...</small>
            </div>

            <div id="resultContainer" class="d-none mt-4"></div>
        </div>

        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-question-circle"></i>
                        Panduan Import
                    </h6>
                </div>
                <div class="card-body">
                    <h6 class="mb-3">📋 Sheet "Events" (1 row = 1 event):</h6>
                    <ul class="small">
                        <li><strong>EventNo</strong> - nomor urut di file ini saja (link ke sheet Participants, bukan EventCode DB)</li>
                        <li><strong>CourseCode</strong> - harus sudah ada di Master Course (TrainingTitle otomatis diambil dari sini)</li>
                        <li><strong>EventType (I/E), CoCode, ABRV</strong> - wajib</li>
                        <li><strong>TrainerId</strong> - wajib jika Internal (TrainerName di-ambil otomatis dari data karyawan)</li>
                        <li><strong>TrainerName</strong> - wajib jika External</li>
                        <li><strong>ParticipantQuota, EventStartDate, EventEndDate</strong> - wajib</li>
                        <li>Venue, SessionCount, DurationHours, Budget, TrainingDescription, TrainingObjective - opsional</li>
                    </ul>

                    <hr>

                    <h6 class="mb-3">👥 Sheet "Participants" (1 row = 1 peserta):</h6>
                    <ul class="small">
                        <li><strong>EventNo</strong> - harus cocok dengan salah satu EventNo di sheet Events</li>
                        <li><strong>EmployeeCode</strong> - Name/Dept diambil otomatis dari data karyawan, tidak perlu diisi manual</li>
                    </ul>

                    <hr>

                    <h6 class="mb-3">✅ Tips:</h6>
                    <ul class="small">
                        <li>✓ Minimal 1 peserta per event</li>
                        <li>✓ Error di satu event tidak menghentikan event lain</li>
                        <li>✓ Event + peserta-nya di-insert sebagai satu unit (atomic) - kalau error, event itu batal seluruhnya</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.APP_BASE_PATH = '@Url.Content("~/")';

        function getApiUrl(endpoint) {
            return window.APP_BASE_PATH + 'api' + endpoint;
        }

        function goBack() {
            if (window.history.length > 1) {
                window.history.back();
            } else {
                window.location.href = window.APP_BASE_PATH;
            }
        }

        $(document).ready(function() {
            $('#eventFile').on('change', function() {
                const file = this.files[0];
                if (file) {
                    $('#selectedFileName').text(file.name);
                    $('#selectedFileSize').text(formatFileSize(file.size));
                    $('#fileInfo').removeClass('d-none');
                } else {
                    $('#fileInfo').addClass('d-none');
                }
            });

            $('#importForm').on('submit', function(e) {
                e.preventDefault();
                importEvents();
            });

            $('#resetBtn').on('click', function() {
                $('#fileInfo').addClass('d-none');
                $('#resultContainer').addClass('d-none').html('');
            });
        });

        function importEvents() {
            const fileInput = document.getElementById('eventFile');
            const file = fileInput.files[0];

            if (!file) {
                Swal.fire('Warning', 'Pilih file terlebih dahulu', 'warning');
                return;
            }

            const maxSize = 5 * 1024 * 1024;
            if (file.size > maxSize) {
                Swal.fire('Error', 'File terlalu besar (max 5MB)', 'error');
                return;
            }

            $('#progressContainer').removeClass('d-none');
            $('#resultContainer').addClass('d-none').html('');
            $('#importBtn').prop('disabled', true);

            const formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: getApiUrl('/eventimport/import-events'),
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function(response) {
                    displayResult(response);
                },
                error: function(xhr) {
                    const errorData = xhr.responseJSON || {};
                    Swal.fire('Error', errorData.message || 'Terjadi error saat import', 'error');
                },
                complete: function() {
                    $('#progressContainer').addClass('d-none');
                    $('#importBtn').prop('disabled', false);
                }
            });
        }

        function displayResult(response) {
            let html = '';

            if (response.successCount > 0) {
                html += `
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle"></i>
                                <strong>✅ Import Berhasil!</strong> ${response.successCount} event berhasil ditambah.
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        `;
            }

            if (response.errors && response.errors.length > 0) {
                html += `
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>⚠️ ${response.errorCount} Event Error:</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">EventNo</th>
                                            <th width="100">CourseCode</th>
                                            <th>Training Title</th>
                                            <th>Error Message</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                response.errors.forEach(error => {
                    html += `
                                <tr>
                                    <td><span class="badge bg-danger">${error.eventNo}</span></td>
                                    <td>${error.courseCode || '-'}</td>
                                    <td><small>${error.trainingTitle || '-'}</small></td>
                                    <td><small class="text-danger">${error.errorMessage}</small></td>
                                </tr>
                            `;
                });

                html += `
                                    </tbody>
                                </table>
                            </div>
                        `;
            }

            html += `
                        <div class="alert alert-info mt-3" role="alert">
                            <strong>📊 Summary:</strong>
                            <br>✅ Success: <span class="badge bg-success">${response.successCount}</span>
                            <br>❌ Error: <span class="badge bg-danger">${response.errorCount}</span>
                        </div>
                    `;

            $('#resultContainer').html(html).removeClass('d-none');

            $('html, body').animate({
                scrollTop: $('#resultContainer').offset().top - 100
            }, 500);
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
        }
    </script>
}
