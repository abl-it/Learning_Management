@model PlanVM
@{
    ViewData["Title"] = "Plans";
}

<style>
    /* ✅ Paksa lebar kolom agar DataTables Responsive bisa hitung dengan benar */
    #dTable th:nth-child(1),
    #dTable td:nth-child(1) 
    {
        width: 50px !important;
        min-width: 50px !important;
    }

    #dTable th:nth-child(2),
    #dTable td:nth-child(2) {
        min-width: 100px !important;
    }

    #dTable th:nth-child(3),
    #dTable td:nth-child(3) {
        width: 40px !important;
        min-width: 40px !important;
    }

    #dTable th:nth-child(4),
    #dTable td:nth-child(4) {
        width: 40px !important;
        min-width: 40px !important;
    }

    #dTable th:nth-child(5),
    #dTable td:nth-child(5) {
        width: 40px !important;
        min-width: 40px !important;
    }


    /* Compact Modal Table Styles */
    .table-compact-modal {
        font-size: 0.75rem; /* Smaller font */
        margin-bottom: 0;
    }

        .table-compact-modal th,
        .table-compact-modal td {
            padding: 0.25rem 0.4rem; /* Much smaller padding */
            vertical-align: middle;
            border-top: 1px solid #dee2e6;
            line-height: 1.2;
        }

        .table-compact-modal th {
            font-size: 0.7rem;
            font-weight: 600;
            background-color: #495057 !important;
            color: white !important;
            border-bottom: 1px solid #343a40 !important;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            padding: 0.3rem 0.4rem;
        }

        .table-compact-modal tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.05);
        }

    /* Compact badges */
    .badge-sm {
        font-size: 0.65rem;
        padding: 0.2rem 0.4rem;
    }

    /* Compact category badges */
    .table-compact-modal .badge {
        font-size: 0.6rem;
        padding: 0.15rem 0.3rem;
    }

    /* Compact action buttons in modal table */
    .table-compact-modal .btn-xs {
        padding: 0.15rem 0.3rem;
        font-size: 0.65rem;
        border-radius: 0.2rem;
        line-height: 1.2;
    }

    /* Course code styling */
    .course-code-cell {
        font-weight: 600;
        color: #0d6efd;
        font-size: 0.7rem;
    }

    /* Course name truncation */
    .course-name-cell {
        font-size: 0.72rem;
        line-height: 1.1;
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Responsive adjustments for modal table */
    @@media (max-width: 768px) {
        .table-compact-modal {
            font-size: 0.7rem;
        }

            .table-compact-modal th,
            .table-compact-modal td {
                padding: 0.2rem 0.3rem;
            }

        .course-name-cell {
            max-width: 150px;
        }
    }

    /* Custom scrollbar for table container */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 3px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }
</style>

<div class="container-fluid">
    <!-- Compact Header -->
    <div class="row justify-content-between align-items-center mb-5">

        <div class="row g-3 align-items-center">
             <div class="col-12 col-md-auto">
                <h4 class="mb-0 fw-medium">
                    <i class="fa-solid fa-people-line me-2"></i>Yearly Training Plans
                </h4>
            </div> 

@*             <div class="col-12 col-md-auto ms-md-auto d-flex flex-column flex-md-row gap-2 justify-content-md-end">
                <a class="btn btn-sm btn-success" href="javascript:void(0);"
                   onclick="Add()">Add Training Plan</a>
            </div> *@
        </div>
    </div>
    
    <!-- Compact Filter Panel -->
    <div class="card card-compact mb-3">
        <input type="hidden" id="currentUser" value="@Model.CurrentUser" />
        <input type="hidden" id="username" value="@Model.Username" />
        <div class="card-header">
            <h6 class="mb-0 fw-medium">
                <i class="fas fa-filter me-2"></i>Filters
            </h6>
        </div>
        <div class="card-body">
            <div class="row spacing-sm align-items-end">
                <!-- Company Code Filter -->
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                    <label for="companyFilter" class="form-label text-xs fw-medium mb-1">Company</label>
                    <select class="form-select form-select-xs" id="companyFilter">
                        @foreach (var item in Model.Companies)
                        {
                            @if (item.CoCode == Model.SelectedCompany)
                            {
                                <option value="@item.CoCode" selected>@item.CompanyName</option>
                            }
                            else
                            {
                                <option value="@item.CoCode">@item.CompanyName</option>
                            }
                            
                        }
                    </select>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                    <label for="yearFilter" class="form-label text-xs fw-medium mb-1">Year</label>
                    <select class="form-select form-select-xs" id="yearFilter">
                        @foreach (var item in Model.YearList)
                        {
                            @if (item.Year == Model.SelectedYear)
                            {
                                <option value="@item.Year" selected>@item.Year</option>
                            }
                            else
                            {
                                <option value="@item.Year">@item.Year</option>
                            }
                        }
                    </select>
                </div>
                @* <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                    <label for="departmentFilter" class="form-label text-xs fw-medium mb-1">Department</label>
                    <select class="form-select form-select-xs" id="departmentFilter">
                        <option value="All">All Department</option>
                        @foreach (var item in Model.Departments)
                        {
                            @if (item.DepartmentID.ToString() == Model.SelectedDepartment)
                            {
                                <option value="@item.DepartmentID" selected>@item.DepartmentName</option>
                            }
                            else
                            {
                                <option value="@item.DepartmentID">@item.DepartmentName</option>
                            }
                        }
                    </select>
                </div> *@
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                    <label for="departmentFilter" class="form-label text-xs fw-medium mb-1">Department</label>
                    <select class="form-select form-select-xs" id="departmentFilter">
                        @if (Model.Departments.Count() > 1)  
                        {
                            <option value="All">--All Department--</option>
                        }
                        @foreach (var item in Model.Departments)
                        {
                            @if (item.ABRV == Model.SelectedDepartment)
                            {
                                <option value="@item.ABRV" selected>@item.DeptName</option>
                            }
                            else
                            {
                                <option value="@item.ABRV">@item.DeptName</option>
                            }
                        }
                    </select>
                </div>
                <!-- Status Filter -->
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-6 col-12">
                    <label for="statusFilter" class="form-label text-xs fw-medium mb-1">Status</label>
                    <select class="form-select form-select-xs" id="statusFilter">
                        @foreach (var item in Model.StatusList)
                        {

                            @if (item == Model.SelectedStatus)
                            {
                                <option value="@item" selected>@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-xl-1 col-lg-1 col-md-6 col-sm-6 col-12">
                    <button type="button" class="btn btn-outline-secondary btn-xs w-100" id="clearFilters">
                        <i class="fas fa-times me-1"></i>Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Compact DataTable -->
    <div class="card card-compact">
        <div class="card-body p-2">
            <!-- Remove padding to maximize space -->
            <table id="dTable" class="table table-striped table-compact" style="width:100%">
                <thead>
                    <tr>
                        @* <th>YEAR</th> *@
                        
                            <th style="width: 40px;">PLAN ID</th>
                            <th style="width: 140px;">DEPARTMENT</th>
                            <th style="width: 40px;">STATUS</th>
                            <th style="width: 25px;">#COURSE</th>
                            <th style="width: 25px;">ACTIONS</th>
                        
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts 
{
<script>
        let dTable;
        $(document).ready(function () {
            dTable = $('#dTable').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                ajax: {
                    url: '@Url.Action("GetPlans", "Planning")',
                    type: 'POST',
                    data: function (d) {
                        d.companyFilter = $('#companyFilter').val();
                        d.yearFilter = $('#yearFilter').val();
                        d.departmentFilter = $('#departmentFilter').val();
                        d.statusFilter = $('#statusFilter').val();
                        d.currentUser = $('#currentUser').val();

                        console.log("Filters =>", d.companyFilter, d.yearFilter, d.departmentFilter, d.statusFilter);
                    }
                },
                columns: [
                    //{ data: 'year' },
                    { data: 'planCode'},
                    { data: 'deptName'},
                    { data: 'planStatus'},
                    { data: 'plansNbr'},
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                                    return `<a href="javascript:void(0);"
                                               class="btn btn-sm btn-primary px-2"
                                               onclick="Edit(${row.planId})"
                                               title="Detail">
                                               <i class="fas fa-eye"></i>
                                            </a>`;
                                }
                    }

                ],
                // ✅ Gunakan columnDefs untuk mengatur responsive
                columnDefs: [
                                   { responsivePriority: 1, targets: 0 }, // planCode
                                    { responsivePriority: 2, targets: 1 }, // deptName
                                    { responsivePriority: 4, targets: 2 }, // planStatus
                                    { responsivePriority: 3, targets: 4 }, // Actions
                                    { responsivePriority: 5, targets: 3 }, // plansNbr → disembunyikan terakhir
                ],
                lengthMenu: [10, 25, 50],
                pageLength: 10,
                order: [[0, 'desc']]
            });
            // Filter change events
            $('#companyFilter, #yearFilter, #departmentFilter, #statusFilter').on('change', function () {
                dTable.ajax.reload();
            });
            // Clear filters
            $('#clearFilters').click(function () {
                    $('#companyFilter').prop('selectedIndex', 0);
                    $('#yearFilter').prop('selectedIndex', 1);
                    $('#departmentFilter').prop('selectedIndex', 0);
                    $('#statusFilter').val('All');
                    dTable.ajax.reload();
            });

            
        }); 
        //Add button click event
        function Edit(id) {
            //alert(id);
            var co = $('#companyFilter').val();   // or whatever your input fields are
            var dp = $('#departmentFilter').val();
            var yr = $('#yearFilter').val();
            var st = $('#statusFilter').val();

            window.location.href = '@Url.Action("PlanDetail", "Planning")?pId=' + encodeURIComponent(id) 
                                    + '&co=' + encodeURIComponent(co)
                                    + '&dp=' + encodeURIComponent(dp)
                                    + '&yr=' + encodeURIComponent(yr)
                                    + '&st=' + encodeURIComponent(st)
        }
</script>
}