        // Validate Need Form
        function validateNeedForm() {
            const groupId = $('#modal-group').val();
            const unitId = $('#modal-unit').val();

            clearNeedError();

            if (!groupId) {
                showNeedError('Please select a group');
                $('#modal-group').focus();
                return false;
            }

            if (!unitId) {
                showNeedError('Please select a unit');
                $('#modal-unit').focus();
                return false;
            }

            if (selectedCourses.length === 0) {
                showNeedError('Please add at least one course');
                return false;
            }

            return true;
        }

        
