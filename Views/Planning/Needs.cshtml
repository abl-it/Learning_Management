        // Add Course to Table (Updated)
        function addCourseToTable() {
            const courseId = $('#selected-course-id').val();

            if (!courseId || !window.selectedCourseData) {
                showNeedError('Please select a course from the search results');
                return;
            }

            const courseData = {
                courseId: courseId,
                courseCode: window.selectedCourseData.courseCode,
                courseName: window.selectedCourseData.courseName,
                categoryCode: window.selectedCourseData.categoryCode,
                color: window.selectedCourseData.color,
            };

            // Check if course already exists
            const exists = selectedCourses.some(course => course.courseId === courseId);
            if (exists) {
                toastr.warning('This course is already added');
                return;
            }

            // Add to array
            selectedCourses.push(courseData);

            // Update table
            updateCoursesTable();

            // Clear selection but keep typeahead enabled
            clearCourseSelection();
            $('#modal-course').focus(); // Focus back to input for next selection

            toastr.success('Course added successfully');
        }

        // Update Courses Table
        function updateCoursesTable() {
            const tbody = $('#selectedCoursesTable tbody');
            const noMessage = $('#no-courses-message');
            const countBadge = $('#course-count');

            tbody.empty();

            if (selectedCourses.length === 0) {
                noMessage.show();
                $('#btn-save-needs').prop('disabled', true);
            } else {
                noMessage.hide();
                $('#btn-save-needs').prop('disabled', false);

                selectedCourses.forEach(function(course, index) {
                    const row = `
                        <tr>
                            <td class="fw-medium">${course.courseCode}</td>
                            <td>${course.courseName}</td>
                            <td>
                                <span class="badge" style="background-color: ${course.color}">${course.categoryCode}</span>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-danger btn-xs remove-course-btn"
                                        data-index="${index}" title="Remove Course">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            }

            countBadge.text(selectedCourses.length);
        }

        // Remove Course from Table
        function removeCourseFromTable(index) {
            selectedCourses.splice(index, 1);
            updateCoursesTable();
            toastr.success('Course removed');
        }

