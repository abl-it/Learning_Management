@using Training.Models.DTO.Event.Realization

@model IReadOnlyList<TrainingEventRealizationListItemDto>

@{
    ViewData["Title"] = "Event Realization";

    string StatusBadgeClass(string? status) => status switch
    {
        "Approved" => "bg-success",
        "Realization Submitted" => "bg-info text-dark",
        "Realization Rejected" => "bg-danger",
        "Complete" => "bg-dark",
        _ => "bg-secondary"
    };

    var statuses = Model
        .Select(m => m.Status)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    var departments = Model
        .Select(m => m.DeptName)
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct()
        .OrderBy(d => d)
        .ToList();
}

<link href="~/css/event.css" rel="stylesheet" />
<link href="~/css/realization-list.css" rel="stylesheet" />

<div class="container-fluid">

    <div class="row justify-content-between align-items-center mb-3">
        <div class="col-12 col-md-auto">
            <h4 class="mb-0 fw-medium">
                <i class="fa-solid fa-calendar-check me-2"></i>Event Realization
            </h4>
            <div class="text-muted small">
                Training events waiting for realization entry or HRD review.
            </div>
        </div>
    </div>

    @if (Model.Count > 0)
    {
        <!-- =========================================================
             FILTERS
             ========================================================= -->

        <div class="card card-compact mb-2">

            <div class="card-body py-2">

                <div class="row g-2">

                    <div class="col-12 col-md-5">
                        <input type="text"
                               id="realizationSearchInput"
                               class="form-control form-control-sm"
                               placeholder="Search event code or title...">
                    </div>

                    <div class="col-6 col-md-4">
                        <select id="realizationStatusFilter" class="form-select form-select-sm">
                            <option value="">All Statuses</option>
                            @foreach (var status in statuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <select id="realizationDeptFilter" class="form-select form-select-sm">
                            <option value="">All Departments</option>
                            @foreach (var dept in departments)
                            {
                                <option value="@dept">@dept</option>
                            }
                        </select>
                    </div>

                </div>

            </div>

        </div>
    }

    <div class="card card-compact">

        <div class="card-body p-0">

            @if (Model.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-inbox display-6 d-block mb-2"></i>
                    Nothing here right now.
                </div>
            }
            else
            {
                <!-- =========================================================
                     DESKTOP TABLE (hidden below md)
                     ========================================================= -->

                <div class="table-responsive d-none d-md-block">

                    <table class="table table-striped table-hover align-middle mb-0" id="realizationTable">

                        <thead class="table-light">
                            <tr>
                                <th>Event Code</th>
                                <th>Training Title</th>
                                <th>Department</th>
                                <th>Event Date</th>
                                <th>Status</th>
                                <th>Realization Date</th>
                                <th style="width:100px;"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="realization-row"
                                    data-search="@($"{item.EventCode} {item.TrainingTitle}".ToLowerInvariant())"
                                    data-status="@item.Status"
                                    data-dept="@item.DeptName">
                                    <td>@item.EventCode</td>
                                    <td>@item.TrainingTitle</td>
                                    <td>@(item.DeptName ?? "-")</td>
                                    <td class="small">
                                        @item.EventStartDate.ToString("dd/MM/yyyy") - @item.EventEndDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        <span class="badge @StatusBadgeClass(item.Status)">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="small">
                                        @(item.RealizationDate?.ToString("dd/MM/yyyy") ?? "-")
                                    </td>
                                    <td>
                                        <a asp-controller="TrainingEvent"
                                           asp-action="Realization"
                                           asp-route-id="@item.TrainingEventId"
                                           class="btn btn-sm btn-primary">
                                            Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <!-- =========================================================
                     MOBILE CARDS (hidden md and up)
                     ========================================================= -->

                <div class="d-block d-md-none" id="realizationCards">

                    @foreach (var item in Model)
                    {
                        <div class="realization-row realization-card p-3 border-bottom"
                             data-search="@($"{item.EventCode} {item.TrainingTitle}".ToLowerInvariant())"
                             data-status="@item.Status"
                             data-dept="@item.DeptName">

                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div class="fw-semibold">@item.EventCode</div>
                                <span class="badge @StatusBadgeClass(item.Status)">
                                    @item.Status
                                </span>
                            </div>

                            <div class="mb-2">@item.TrainingTitle</div>

                            <div class="small text-muted mb-1">
                                <i class="bi bi-building me-1"></i>@(item.DeptName ?? "-")
                            </div>

                            <div class="small text-muted mb-1">
                                <i class="bi bi-calendar-event me-1"></i>
                                @item.EventStartDate.ToString("dd/MM/yyyy") - @item.EventEndDate.ToString("dd/MM/yyyy")
                            </div>

                            @if (item.RealizationDate.HasValue)
                            {
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-clipboard-check me-1"></i>
                                    Realized: @item.RealizationDate.Value.ToString("dd/MM/yyyy")
                                </div>
                            }

                            <a asp-controller="TrainingEvent"
                               asp-action="Realization"
                               asp-route-id="@item.TrainingEventId"
                               class="btn btn-sm btn-primary w-100 mt-1">
                                Open
                            </a>

                        </div>
                    }

                </div>

                <div class="text-center text-muted py-4 d-none" id="realizationNoResults">
                    <i class="bi bi-search display-6 d-block mb-2"></i>
                    No events match your filters.
                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/realization-list.js" asp-append-version="true"></script>
}
