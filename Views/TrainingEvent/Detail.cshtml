                </div>

                <div class="col-md-3">

                    <label class="form-label mb-1">
                        Modified Date
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@(Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")"
                           readonly />

                </div>

            </div>

        </div>

    </div> *@

</div>


   


<!-- =============================================================
     REJECT MODAL
     ============================================================= -->
    @if (Model.CanAction)
    {
        <div class="modal fade"
             id="rejectEventModal"
             tabindex="-1"
             aria-labelledby="rejectEventModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header py-2">

                        <h6 class="modal-title"
                            id="rejectEventModalLabel">

                            <i class="bi bi-x-circle text-danger"></i>
                            Reject Training Event

                        </h6>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="alert alert-warning py-2 small">

                            <i class="bi bi-exclamation-triangle"></i>

                            Please provide a reason for rejecting
                            this training event.

                        </div>

                        <label for="rejectReason"
                               class="form-label">

                            Reject Reason
                            <span class="text-danger">*</span>

                        </label>

                        <textarea id="rejectReason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Enter rejection reason..."></textarea>

                        <div class="invalid-feedback">
                            Reject reason is required.
                        </div>

                    </div>

                    <div class="modal-footer py-2">

                        <button type="button"
                                class="btn btn-sm btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                id="btnConfirmReject">

                            <i class="bi bi-x-lg"></i>
                            Reject

                        </button>

                    </div>

                </div>

            </div>

        </div>
    }




<form id="deleteEventForm"
      asp-controller="TrainingEvent"
      asp-action="Delete"
      method="post"
      class="d-none">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           value="@Model.TrainingEventId" />

</form>
@section Scripts {

    <script>

        const trainingEventDetailUrls = {
    index: '@Url.Action("Index", "TrainingEvent")',
    edit: '@Url.Action("Edit", "TrainingEvent")',
    delete: '@Url.Action("Delete", "TrainingEvent")',
    eventAction: '@Url.Action("EventAct", "Action")'
};

        const trainingEventDetail = {
            id: @Model.TrainingEventId,
            canEdit: @Model.CanEdit.ToString().ToLowerInvariant(),
            canAction: @Model.CanAction.ToString().ToLowerInvariant(),
            availableAction: '@(Model.AvailableAction ?? "")',
            docStatus: @(Model.DocStatus ?? 0)
        };

    </script>

    <script src="~/js/training-event-detail.js"
            asp-append-version="true"></script>
}