@using Training.Models.DTO.Event

@model TrainingEventDetailDto



@{
    ViewData["Title"] = "Training Event Detail";

    var docStatus = Model.DocStatus ?? 0;

    var eventTypeText =
        Model.EventType == "I"
            ? "Internal"
            : Model.EventType == "E"
                ? "External"
                : Model.EventType;

    var statusClass =
        docStatus == 0
            ? "bg-secondary"
            : docStatus == 1
                ? "bg-warning text-dark"
                : "bg-success";
}

<link href="~/css/detail.css" rel="stylesheet" />


<div class="container px-3 px-md-4 training-event-detail-container">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-2">

        <div>

            <h4 class="mb-0">

                <i class="bi bi-calendar-event"></i>

                Training Event

            </h4>

            <div class="text-muted small">
                @Model.EventCode
            </div>

        </div>


        <div class="d-flex gap-1">

            <!-- =================================================
                 EDIT / DELETE
                 ================================================= -->

            @if (Model.CanEdit)
            {
                <a asp-controller="TrainingEvent"
                   asp-action="Edit"
                   asp-route-id="@Model.TrainingEventId"
                   class="btn btn-sm btn-warning">

                    <i class="bi bi-pencil-square"></i>

                    Edit

                </a>


                <button type="button"
                        class="btn btn-sm btn-danger"
                        id="btnDeleteEvent"
                        data-id="@Model.TrainingEventId">

                    <i class="bi bi-trash"></i>

                    Delete

                </button>
            }


            <!-- =================================================
                 WORKFLOW ACTION
                 ================================================= -->

            @if (Model.CanAction)
            {
                @if (string.Equals(
                    Model.AvailableAction,
                    "Post",
                    StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button"
                            class="btn btn-sm btn-primary"
                            id="btnPostEvent">

                        <i class="bi bi-send"></i>

                        Post

                    </button>
                }
                else if (string.Equals(
                    Model.AvailableAction,
                    "ApproveReject",
                    StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button"
                            class="btn btn-sm btn-success"
                            id="btnApproveEvent">

                        <i class="bi bi-check-lg"></i>

                        Approve

                    </button>


                    <button type="button"
                            class="btn btn-sm btn-danger"
                            id="btnRejectEvent">

                        <i class="bi bi-x-lg"></i>

                        Reject

                    </button>
                }
            }


            <!-- =================================================
                 BACK
                 ================================================= -->

            <button type="button"
                    class="btn btn-sm btn-secondary"
                    id="btnBackToEventIndex">

                <i class="bi bi-arrow-left"></i>

                Back

            </button>

        </div>

    </div>


    <!-- =========================================================
         EVENT INFORMATION
         ========================================================= -->

    <div class="card shadow-sm mb-2">

        <div class="card-header py-2 d-flex justify-content-between align-items-center">

            <span>

                <i class="bi bi-info-circle me-1"></i>

                Event Information

            </span>


            <span class="badge @statusClass">

                @(Model.Status ?? "Draft")

            </span>

        </div>


        <div class="card-body">

            <div class="row g-2">

                <!-- =================================================
                     COURSE
                     ================================================= -->

                <div class="col-md-5">

                    <label class="form-label">
                        Course
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.CourseCode"
                           readonly />

                </div>


                <!-- =================================================
                     TRAINING TITLE
                     ================================================= -->

                <div class="col-md-4">

                    <label class="form-label">
                        Training Title
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.TrainingTitle"
                           readonly />

                </div>


                <!-- =================================================
                     CATEGORY
                     ================================================= -->

                <div class="col-md-3">

                    <label class="form-label">
                        Training Category
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.TrainingCategory"
                           readonly />

                </div>


                <!-- =================================================
                     COMPANY
                     ================================================= -->

                <div class="col-md-3">

                    <label class="form-label">
                        Company
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.CoCode"
                           readonly />

                </div>


                <!-- =================================================
                     DEPARTMENT
                     ================================================= -->

                <div class="col-md-3">

                    <label class="form-label">
                        Department
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.DeptName"
                           readonly />

                </div>


                <!-- =================================================
                     TRAINER TYPE
                     ================================================= -->

                <div class="col-md-2">

                    <label class="form-label">
                        Trainer Type
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@eventTypeText"
                           readonly />

                </div>


                <!-- =================================================
                     TRAINER
                     ================================================= -->

                <div class="col-md-4">

                    <label class="form-label">
                        Trainer
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.TrainerName"
                           readonly />

                </div>


                <!-- =================================================
                     SESSION
                     ================================================= -->

                <div class="col-md-2">

                    <label class="form-label">
                        Session#
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.SessionCount"
                           readonly />

                </div>


                <!-- =================================================
                     DURATION
                     ================================================= -->

                <div class="col-md-2">

                    <label class="form-label">
                        Duration (Hours)
                    </label>

                    <div class="input-group input-group-sm">

                        <input type="text"
                               class="form-control"
                               value="@Model.DurationHours"
                               readonly />

                        <span class="input-group-text">
                            hrs
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     QUOTA
                     ================================================= -->

                <div class="col-md-2">

                    <label class="form-label">
                        Quota
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.ParticipantQuota"
                           readonly />

                </div>


                <!-- =================================================
                     START DATE
                     ================================================= -->

                <div class="col-md-3">

                    <label class="form-label">
                        Start Date
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.EventStartDate.ToString("dd/MM/yyyy HH:mm")"
                           readonly />

                </div>


                <!-- =================================================
                     END DATE
                     ================================================= -->

                <div class="col-md-3">

                    <label class="form-label">
                        End Date
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.EventEndDate.ToString("dd/MM/yyyy HH:mm")"
                           readonly />

                </div>


                <!-- =================================================
                     VENUE
                     ================================================= -->

                <div class="col-md-4">

                    <label class="form-label">
                        Venue
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.Venue"
                           readonly />

                </div>


                <!-- =================================================
                     BUDGET
                     ================================================= -->

                <div class="col-md-2">

                    <label class="form-label">
                        Budget
                    </label>

                    <input type="text"
                           class="form-control form-control-sm text-end"
                           value="@(Model.Budget?.ToString("#,##0.00") ?? "-")"
                           readonly />

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         TRAINING INFORMATION
         ========================================================= -->

    <div class="card shadow-sm mb-2">

        <div class="card-header py-2">

            <i class="bi bi-file-text me-1"></i>

            Training Information

        </div>


        <div class="card-body">

            <div class="row g-2">

                <div class="col-md-6">

                    <label class="form-label">
                        Training Description
                    </label>

                    <textarea class="form-control form-control-sm"
                              rows="3"
                              readonly>@Model.TrainingDescription</textarea>

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        Training Objective
                    </label>

                    <textarea class="form-control form-control-sm"
                              rows="3"
                              readonly>@Model.TrainingObjective</textarea>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PARTICIPANTS
         ========================================================= -->

    <div class="card shadow-sm mb-2">

        <div class="card-header py-2 d-flex justify-content-between align-items-center">

            <span>

                <i class="bi bi-people-fill me-1"></i>

                Participants

            </span>


            <span class="badge bg-primary">

                @(Model.Participants?.Count ?? 0)

            </span>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-sm table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width:50px;"
                                class="text-center">
                                #
                            </th>

                            <th style="width:130px;">
                                Employee Code
                            </th>

                            <th>
                                Name
                            </th>

                            <th style="width:100px;">
                                ABRV
                            </th>

                            <th>
                                Department
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Participants != null &&
                             Model.Participants.Any())
                        {
                            var no = 1;

                            foreach (var participant in Model.Participants)
                            {
                                <tr>

                                    <td class="text-center">
                                        @no
                                    </td>

                                    <td>
                                        @participant.EmployeeCode
                                    </td>

                                    <td>
                                        @participant.Name
                                    </td>

                                    <td>
                                        @(participant.ABRV ?? "-")
                                    </td>

                                    <td>
                                        @(participant.DeptName ?? "-")
                                    </td>

                                </tr>

                                no++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center text-muted py-3">

                                    No participants found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================================================
         WORKFLOW HISTORY
         ========================================================= -->

    <div class="card shadow-sm mb-3 workflow-history-card">

        <div class="card-header py-2">

            <i class="bi bi-clock-history me-1"></i>

            Workflow History

        </div>


        <div class="card-body">

            @if (Model.Histories != null &&
                 Model.Histories.Any())
            {
                <div class="workflow-timeline">

                    @foreach (var history in Model.Histories)
                    {
                        var action =
                            history.Action ?? "-";

                        var actionClass =
                            action.Equals(
                                "Reject",
                                StringComparison.OrdinalIgnoreCase)
                                ? "history-reject"
                                : action.Equals(
                                    "Approve",
                                    StringComparison.OrdinalIgnoreCase)
                                    ? "history-approve"
                                    : action.Equals(
                                        "Request for Approve",
                                        StringComparison.OrdinalIgnoreCase)
                                        ? "history-request"
                                        : "history-default";

                        var actionIcon =
                            action.Equals(
                                "Reject",
                                StringComparison.OrdinalIgnoreCase)
                                ? "bi-x-lg"
                                : action.Equals(
                                    "Approve",
                                    StringComparison.OrdinalIgnoreCase)
                                    ? "bi-check-lg"
                                    : action.Equals(
                                        "Request for Approve",
                                        StringComparison.OrdinalIgnoreCase)
                                        ? "bi-send"
                                        : "bi-arrow-right";

                        <div class="workflow-timeline-item">

                            <div class="workflow-timeline-marker @actionClass">

                                <i class="bi @actionIcon"></i>

                            </div>


                            <div class="workflow-history-person">

                                <div class="workflow-history-date">

                                    @history.Date.ToString(
                                        "dd MMM yyyy HH:mm")

                                </div>


                                <div class="workflow-history-user">

                                    @(string.IsNullOrWhiteSpace(
                                        history.ChangeByName)
                                        ? history.ChangeBy
                                        : history.ChangeByName)

                                </div>

                            </div>


                            <div class="workflow-history-content">

                                <div class="workflow-history-main">

                                    <span class="workflow-history-action @actionClass">

                                        <i class="bi @actionIcon"></i>

                                        @action

                                    </span>


                                    <span class="workflow-state">

                                        @(history.State ?? "-")

                                    </span>


                                    <i class="bi bi-arrow-right workflow-history-arrow"></i>


                                    <span class="workflow-state workflow-state-next">

                                        @(history.NextState ?? "-")

                                    </span>

                                </div>


                                <div class="workflow-history-remark">

                                    <strong>Remarks:</strong>

                                    @if (string.IsNullOrWhiteSpace(
                                        history.Remark))
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            @history.Remark
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">

                    <i class="bi bi-clock-history fs-3 d-block mb-2"></i>

                    No workflow history available.

                </div>
            }

        </div>

    </div>

</div>


<!-- =============================================================
     DELETE FORM
     ============================================================= -->

<form id="deleteEventForm"
      asp-controller="TrainingEvent"
      asp-action="Delete"
      method="post"
      class="d-none">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           value="@Model.TrainingEventId" />

</form>


<!-- =============================================================
     REJECT MODAL
     ============================================================= -->

@if (Model.CanAction)
{
    <div class="modal fade"
         id="rejectReasonModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">

                        <i class="bi bi-x-circle me-1"></i>

                        Reject Training Event

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <label for="rejectReason"
                           class="form-label">

                        Reason
                        <span class="text-danger">*</span>

                    </label>

                    <textarea id="rejectReason"
                              class="form-control form-control-sm"
                              rows="4"
                              maxlength="500"
                              placeholder="Enter rejection reason..."></textarea>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-sm btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="button"
                            class="btn btn-sm btn-danger"
                            id="btnConfirmReject">

                        <i class="bi bi-x-lg me-1"></i>

                        Reject

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script>

        const trainingEventDetailUrls = {

            index:
                '@Url.Action("Index", "TrainingEvent")',

            edit:
                '@Url.Action("Edit", "TrainingEvent")',

            delete:
                '@Url.Action("Delete", "TrainingEvent")',

            eventAction:
                '@Url.Action("EventAct", "Action")'

        };


        const trainingEventDetail = {

            id:
                @Model.TrainingEventId,

            canEdit:
                @Model.CanEdit.ToString().ToLowerInvariant(),

            canAction:
                @Model.CanAction.ToString().ToLowerInvariant(),

            availableAction:
                '@(Model.AvailableAction ?? "")',

            docStatus:
                @(Model.DocStatus ?? 0)

        };

    </script>


    <script src="~/js/training-event-detail.js"
            asp-append-version="true"></script>

}