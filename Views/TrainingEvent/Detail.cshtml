@using Training.Models.DTO.Event
@model TrainingEventDetailDto

@{
    ViewData["Title"] = "Training Event Detail";

    var docStatus = Model.DocStatus ?? 0;

    var eventTypeText =
        Model.EventType == "I"
            ? "Internal"
            : Model.EventType == "E"
                ? "External"
                : Model.EventType;

    var statusClass =
        docStatus == 0
            ? "bg-secondary"
            : docStatus == 1
                ? "bg-warning text-dark"
                : "bg-success";
}

<link href="~/css/detail.css" rel="stylesheet" />

<div class="container px-3">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-2">

    <div>
        <h4 class="mb-0">
            <i class="bi bi-calendar-event"></i>
            Training Event
        </h4>

        <div class="text-muted small">
            @Model.EventCode
        </div>
    </div>

    <div class="d-flex gap-1">

        @* =====================================================
           EDIT / DELETE
           ===================================================== *@

        @if (Model.CanEdit)
        {
            <a asp-controller="TrainingEvent"
               asp-action="Edit"
               asp-route-id="@Model.TrainingEventId"
               class="btn btn-sm btn-warning">

                <i class="bi bi-pencil-square"></i>
                Edit
            </a>

            <button type="button"
                    class="btn btn-sm btn-danger"
                    id="btnDeleteEvent"
                    data-id="@Model.TrainingEventId">

                <i class="bi bi-trash"></i>
                Delete
            </button>
        }


        @* =====================================================
           WORKFLOW ACTION
           ===================================================== *@

        @if (Model.CanAction &&
             Model.AvailableAction == "Post")
        {
            <button type="button"
                    class="btn btn-sm btn-primary"
                    id="btnPostEvent">

                <i class="bi bi-send"></i>
                Post
            </button>
        }

        @if (Model.CanAction &&
             Model.AvailableAction == "ApproveReject")
        {
            <button type="button"
                    class="btn btn-sm btn-success"
                    id="btnApproveEvent">

                <i class="bi bi-check-lg"></i>
                Approve
            </button>

            <button type="button"
                    class="btn btn-sm btn-danger"
                    id="btnRejectEvent">

                <i class="bi bi-x-lg"></i>
                Reject
            </button>
        }


        @* =====================================================
           BACK
           ===================================================== *@

        <button type="button"
                class="btn btn-sm btn-secondary"
                id="btnBackToEventIndex">

            <i class="bi bi-arrow-left"></i>
            Back
        </button>

    </div>
</div>


    <!-- =========================================================
         EVENT INFORMATION
         ========================================================= -->

    <div class="card shadow-sm mb-2">

        <div class="card-header py-2 d-flex justify-content-between align-items-center">

            <span class="fw-semibold">
                <i class="fas fa-info-circle me-1"></i>
                Event Information
            </span>

            <span class="badge @statusClass">
                @Model.Status
            </span>

        </div>

        <div class="card-body py-2">

            <div class="row g-2">

                <!-- Event Code -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Event Code
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.EventCode"
                           readonly />
                </div>

                <!-- Course -->
                <div class="col-md-4">
                    <label class="form-label mb-1">
                        Course
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.CourseName"
                           readonly />
                </div>

                <!-- Category -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Category
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.TrainingCategory"
                           readonly />
                </div>

                <!-- Type -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Type
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@eventTypeText"
                           readonly />
                </div>

                <!-- Company -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Company
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.CoCode"
                           readonly />
                </div>


                <!-- Department -->
                <div class="col-md-3">
                    <label class="form-label mb-1">
                        Department
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.DeptName"
                           readonly />
                </div>

                <!-- Trainer -->
                <div class="col-md-4">
                    <label class="form-label mb-1">
                        Trainer
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.TrainerName"
                           readonly />
                </div>

                <!-- Trainer ID -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Trainer ID
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.TrainerId"
                           readonly />
                </div>

                <!-- Session -->
                <div class="col-md-1">
                    <label class="form-label mb-1">
                        Session
                    </label>

                    <input type="text"
                           class="form-control form-control-sm text-center"
                           value="@Model.SessionCount"
                           readonly />
                </div>

                <!-- Hours -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Hours
                    </label>

                    <div class="input-group input-group-sm">

                        <input type="text"
                               class="form-control text-end"
                               value="@Model.DurationHours"
                               readonly />

                        <span class="input-group-text">
                            hrs
                        </span>

                    </div>
                </div>


                <!-- Start Date -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Start Date
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.EventStartDate.ToString("dd/MM/yyyy HH:mm")"
                           readonly />
                </div>

                <!-- End Date -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        End Date
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.EventEndDate.ToString("dd/MM/yyyy HH:mm")"
                           readonly />
                </div>

                <!-- Venue -->
                <div class="col-md-4">
                    <label class="form-label mb-1">
                        Venue
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.Venue"
                           readonly />
                </div>

                <!-- Budget -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Budget
                    </label>

                    <input type="text"
                           class="form-control form-control-sm text-end"
                           value="@(Model.Budget?.ToString("#,##0.00") ?? "-")"
                           readonly />
                </div>

                <!-- Participant -->
                <div class="col-md-2">
                    <label class="form-label mb-1">
                        Participants
                    </label>

                    <input type="text"
                           class="form-control form-control-sm text-center"
                           value="@Model.ParticipantQuota"
                           readonly />
                </div>

            </div>

        </div>
    </div>


    <!-- =========================================================
         TITLE / DESCRIPTION / OBJECTIVE
         ========================================================= -->

    <div class="card shadow-sm mb-2">

        <div class="card-header py-2">
            <span class="fw-semibold">
                <i class="fas fa-file-alt me-1"></i>
                Training Information
            </span>
        </div>

        <div class="card-body py-2">

            <div class="row g-2">

                <div class="col-md-12">

                    <label class="form-label mb-1">
                        Training Title
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.TrainingTitle"
                           readonly />

                </div>

                <div class="col-md-6">

                    <label class="form-label mb-1">
                        Description
                    </label>

                    <textarea class="form-control form-control-sm"
                              rows="3"
                              readonly>@Model.TrainingDescription</textarea>

                </div>

                <div class="col-md-6">

                    <label class="form-label mb-1">
                        Objective
                    </label>

                    <textarea class="form-control form-control-sm"
                              rows="3"
                              readonly>@Model.TrainingObjective</textarea>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PARTICIPANTS
         ========================================================= -->

    <div class="card shadow-sm mb-2">

        <div class="card-header py-2 d-flex justify-content-between align-items-center">

            <span class="fw-semibold">
                <i class="fas fa-users me-1"></i>
                Participants
            </span>


            <div class="d-flex align-items-center gap-2">

                <span class="badge bg-primary">
                    @Model.Participants.Count
                </span>
                @if (docStatus == 2)
                {
                    <a asp-controller="TrainingEvent"
                   asp-action="PrintAttendance"
                   asp-route-id="@Model.TrainingEventId"
                   target="_blank"
                   class="btn btn-sm btn-outline-secondary">

                    <i class="bi bi-printer"></i>
                    Print Attendance
                </a>
                }
                

            </div>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-sm table-hover table-bordered mb-0">

                    <thead class="table-light">

                        <tr>
                            <th style="width:45px"
                                class="text-center">
                                #
                            </th>

                            <th style="width:140px">
                                Employee Code
                            </th>

                            <th>
                                Name
                            </th>

                            <th style="width:100px">
                                ABRV
                            </th>

                            <th>
                                Department
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Participants.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-3">
                                    No participants found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var no = 1;

                            foreach (var participant in Model.Participants)
                            {
                                <tr>

                                    <td class="text-center">
                                        @no
                                    </td>

                                    <td>
                                        @participant.EmployeeCode
                                    </td>

                                    <td>
                                        @participant.Name
                                    </td>

                                    <td>
                                        @participant.ABRV
                                    </td>

                                    <td>
                                        @participant.DeptName
                                    </td>

                                </tr>

                                no++;
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- =========================================================
     WORKFLOW HISTORY
     ========================================================= -->
    <div class="card shadow-sm mb-3 workflow-history-card">

        <div class="card-header bg-white">
            <h6 class="mb-0">
                <i class="bi bi-clock-history me-1"></i>
                Workflow History
            </h6>
        </div>

        <div class="card-body">

            @if (Model.Histories != null && Model.Histories.Any())
            {
                <div class="workflow-timeline">

                    @foreach (var history in Model.Histories)
                    {
                        var action = history.Action ?? "-";

                        var actionClass =
                            action.Equals("Reject", StringComparison.OrdinalIgnoreCase)
                                ? "history-reject"
                                : action.Equals("Approve", StringComparison.OrdinalIgnoreCase)
                                    ? "history-approve"
                                    : action.Equals("Request for Approve", StringComparison.OrdinalIgnoreCase)
                                        ? "history-request"
                                        : "history-default";

                        var actionIcon =
                            action.Equals("Reject", StringComparison.OrdinalIgnoreCase)
                                ? "bi-x-circle"
                                : action.Equals("Approve", StringComparison.OrdinalIgnoreCase)
                                    ? "bi-check-circle"
                                    : action.Equals("Request for Approve", StringComparison.OrdinalIgnoreCase)
                                        ? "bi-send"
                                        : "bi-pencil";

                        <div class="workflow-timeline-item">

                            <!-- Timeline marker -->
                            <div class="workflow-timeline-marker @actionClass">
                                <i class="bi @actionIcon"></i>
                            </div>

                            <!-- Date & User -->
                            <div class="workflow-history-person">

                                <div class="workflow-history-date">
                                    @history.Date.ToString("dd MMM yyyy HH:mm")
                                </div>

                                <div class="workflow-history-user">
                                    @(string.IsNullOrWhiteSpace(history.ChangeByName)
                                        ? history.ChangeBy
                                        : history.ChangeByName)
                                </div>

                            </div>

                            <!-- History Detail -->
                            <div class="workflow-history-content">

                                <div class="workflow-history-main">

                                    <!-- Action -->
                                    <span class="workflow-history-action @actionClass">
                                        <i class="bi @actionIcon me-1"></i>
                                        @action
                                    </span>

                                    <!-- From State -->
                                    <span class="workflow-state">
                                        @(string.IsNullOrWhiteSpace(history.State)
                                            ? "-"
                                            : history.State)
                                    </span>

                                    <i class="bi bi-arrow-right workflow-history-arrow"></i>

                                    <!-- To State -->
                                    <span class="workflow-state workflow-state-next">
                                        @(string.IsNullOrWhiteSpace(history.NextState)
                                            ? "-"
                                            : history.NextState)
                                    </span>

                                </div>

                                <!-- Remark -->
                                <div class="workflow-history-remark">
                                    <strong>Remarks:</strong>

                                    @if (string.IsNullOrWhiteSpace(history.Remark))
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        <span>@history.Remark</span>
                                    }
                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center text-muted py-3 workflow-history-empty">
                    <i class="bi bi-clock-history fs-4 d-block mb-2"></i>
                    No workflow history available.
                </div>
            }

        </div>
    </div>       

    <!-- =========================================================
         AUDIT INFORMATION
         ========================================================= -->

