            </span>
        </div>

        <div class="card-body py-2">

            <div class="row g-2">

                <div class="col-md-3">

                    <label class="form-label mb-1">
                        Created By
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.CreatedBy"
                           readonly />

                </div>

                <div class="col-md-3">

                    <label class="form-label mb-1">
                        Created Date
                    </label>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")"
                           readonly />

                </div>

                <div class="col-md-3">

                    <label class="form-label mb-1">
