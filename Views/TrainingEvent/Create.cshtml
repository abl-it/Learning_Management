@{
    ViewData["Title"] = "Add Training Event";
}

<div class="container px-3 px-md-4">

    <div class="d-flex align-items-center mb-3">
        <i class="bi bi-people-fill fs-4 me-2"></i>
        <h4 class="mb-0">Add Training Event</h4>
    </div>

    <form id="trainingEventForm"
          asp-controller="TrainingEvent"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="card shadow-sm">

            <div class="card-header">
                <i class="bi bi-calendar-plus me-1"></i>
                Event Information
            </div>

            <div class="card-body">

                <!-- Hidden -->
                <input type="hidden"
                       id="CourseId"
                       name="CourseId" />

                <div class="row g-3">

                    <!-- COURSE -->
                    <div class="col-12 col-lg-5">

                        <label for="courseSearch"
                               class="form-label">
                            Course
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="courseSearch"
                               class="form-control form-control-sm"
                               placeholder="Search course code or course name..."
                               autocomplete="off"
                               required />

                        <div class="form-text">
                            Type at least 2 characters.
                        </div>

                    </div>


                    <!-- TRAINING TITLE -->
                    <div class="col-12 col-lg-4">

                        <label class="form-label">
                            Training Title
                        </label>

                        <input type="text"
                               id="TrainingTitle"
                               name="TrainingTitle"
                               class="form-control form-control-sm"
                               readonly />

                    </div>


                    <!-- CATEGORY -->
                    <div class="col-12 col-lg-3">

                        <label class="form-label">
                            Category
                        </label>

                        <input type="text"
                               id="CategoryName"
                               class="form-control form-control-sm"
                               readonly />
                        <input type="hidden"
                               id="CategoryId"
                               name="TrainingCategoryId">
                    </div>

                 <!-- Company -->
                    <div class="col-md-3">
                        <label for="CoCode" class="form-label">
                            Company <span class="text-danger">*</span>
                        </label>

                        <select id="CoCode"
                                name="CoCode"
                                class="form-select form-select-sm"
                                required>
                            <option value="">Loading...</option>
                        </select>
                    </div>

                    <!-- Department -->
                    <div class="col-md-3">
                        <label for="ABRV" class="form-label">
                            Department <span class="text-danger">*</span>
                        </label>

                        <select id="ABRV"
                                name="ABRV"
                                class="form-select form-select-sm"
                                required>
                            <option value="">Select Department</option>
                        </select>
                    </div>

                    <!-- Type -->
                    <div class="col-md-2">
                        <label for="TrainerType" class="form-label">
                            Trainer Type
                        </label>

                        <select id="TrainerType"
                                name="TrainerType"
                                class="form-select form-select-sm">
                            <option value="Internal">Internal</option>
                            <option value="External">External</option>
                        </select>
                    </div>

                    <!--Trainer-->
                    <div class="col-md-3">
                        <label for="TrainerSearch" class="form-label">
                            Trainer <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="TrainerSearch"
                               class="form-control form-control-sm"
                               placeholder="Search employee..."
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               id="TrainerEmployeeCode"
                               name="TrainerEmployeeCode" />

                        <input type="hidden"
                               id="TrainerName"
                               name="TrainerName" />
                    </div>

                    <!-- #Participant -->
                    @* <div class="col-md-1"> 
                        <label for="Quota" class="form-label">
                            #Participant <span class="text-danger">*</span>
                        </label>

                        <input type="number"
                               id="Quota"
                               name="Quota"
                               class="form-control form-control-sm"
                               min="1"
                               value="1"
                               required>
                    </div>
                    *@
        </div>


                <div class="row g-3 mt-1">

            <!-- Session -->
            <div class="col-md-1">
                <label for="SessionNo" class="form-label">
                    #Sess
                    <span class="text-danger">*</span>
                </label>

                <input type="number"
                       id="SessionNo"
                       name="SessionNo"
                       class="form-control form-control-sm"
                       min="1"
                       value="1"
                       required>
            </div>


            <!-- Hours -->
            <div class="col-md-2">
                <label for="HoursPerSession" class="form-label">
                    Hours / Session
                </label>

                        <div class="input-group input-group-sm hours-session">
                            <input type="number"
                                   id="HoursPerSession"
                                   name="HoursPerSession"
                                   class="form-control"
                                   min="1"
                                   step="0.5">

                            <span class="input-group-text">hrs</span>
                        </div>
            </div>


            <!-- Start Date -->
            <div class="col-md-2">
                <label for="StartDate" class="form-label">
                    Start Date <span class="text-danger">*</span>
                </label>

                <input type="datetime-local"
                       id="StartDate"
                       name="StartDate"
                       class="form-control form-control-sm"
                       required>
            </div>


            <!-- End Date -->
            <div class="col-md-2">
                <label for="EndDate" class="form-label">
                    End Date <span class="text-danger">*</span>
                </label>

                <input type="datetime-local"
                       id="EndDate"
                       name="EndDate"
                       class="form-control form-control-sm"
                       required>
            </div>


            <!-- Venue -->
            <div class="col-md-3">
                <label for="Venue" class="form-label">
                    Venue
                </label>

                <input type="text"
                       id="Venue"
                       name="Venue"
                       class="form-control form-control-sm">
            </div>


            <!-- Budget -->
            <div class="col-md-2">
                <label for="Budget" class="form-label">
                    Budget
                </label>

                <input type="number"
                       id="Budget"
                       name="Budget"
                       class="form-control form-control-sm"
                       min="0"
                       step="0.01">
            </div>

        </div>


            <!-- Description -->
            <div class="row mt-3">
                <div class="col-12">

                    <label for="Description" class="form-label">
                        Description
                    </label>

                    <textarea id="Description"
                              name="Description"
                              class="form-control form-control-sm"
                              rows="3"></textarea>

                </div>
            </div>


            <!-- Objective -->
            <div class="row mt-3">
                <div class="col-12">

                    <label for="Objective" class="form-label">
                        Objective
                    </label>

                    <textarea id="Objective"
                              name="Objective"
                              class="form-control"
                              rows="3"></textarea>

                </div>

            </div>
    
            <!-- PARTICIPANTS -->
            <div class="card shadow-sm mt-3">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <span>
                        <i class="bi bi-person-check me-1"></i>
                        Planned Participants
                    </span>

                    <button type="button"
                            id="btnAddParticipant"
                            class="btn btn-sm btn-primary">

                        <i class="bi bi-person-plus me-1"></i>
                        Add Participant

                    </button>

                </div>

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table id="participantTable"
                               class="table table-sm table-hover mb-0">

                                <thead>
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>Employee Code</th>
                                        <th>Name</th>
                                        <th>Department</th>
                                        <th style="width: 80px;">Action</th>
                                    </tr>
                                </thead>

                                <tbody id="participantTableBody">
                                </tbody>

                        </table>
                            <div id="participantEmpty"
                                 class="text-center text-muted py-3">
                                No participants added.
                            </div>

                    </div>

                </div>
            </div>

            <!-- ACTION -->
            <div class="d-flex justify-content-end gap-2 mt-3 mb-4">

                <button type="button"
                        id="btnCancel"
                        class="btn btn-sm btn-outline-secondary">

                    <i class="bi bi-x-lg me-1"></i>
                    Cancel

                </button>

                <button type="button"
                        id="btnSaveEvent"
                        class="btn btn-sm btn-success">

                    <i class="bi bi-check-lg me-1"></i>
                    Save Event

                </button>

            </div>

        </div>
        </div>
    </form>

</div>


<!-- =========================================================
     PARTICIPANT MODAL
========================================================= -->

<div class="modal fade"
     id="participantModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    <i class="bi bi-person-plus me-1"></i>
                    Add Participant
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                    <div class="mb-3">
                        <label for="ParticipantSearch" class="form-label">
                            Employee <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="ParticipantSearch"
                               class="form-control form-control-sm"
                               placeholder="Search employee code or name..."
                               autocomplete="off" />

                        <input type="hidden"
                               id="ParticipantEmployeeCode" />

                        <input type="hidden"
                               id="ParticipantName" />

                        <input type="hidden"
                               id="ParticipantDepartment" />

                        <input type="hidden"
                               id="ParticipantDepartmentName" />
                    </div>

                <div id="selectedEmployee"
                     class="alert alert-light border d-none">

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <button type="button"
                        id="btnConfirmParticipant"
                        class="btn btn-sm btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>
                    Add

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        window.trainingEventCreateUrls = {
            getCourses: '@Url.Action("GetCourses", "TrainingEvent")',

            getCompanies: '@Url.Action("GetCompanies", "Home", new { type = "EVENT" })',

            getDepartments: '@Url.Action("GetDepartments", "Home", new { type = "EVENT" })',

            searchEmployees: '@Url.Action("SearchEmployees", "Home")',

            save: '@Url.Action("Create", "TrainingEvent")',

            index: '@Url.Action("Index", "TrainingEvent")'
        };

        console.log(
            'Training Event Create URLs:',
            window.trainingEventCreateUrls
        );
    </script>
    <script src="~/lib/bootstrap3-typeahead/bootstrap3-typeahead.min.js"></script>
        <script src="~/js/training-event-create.js" asp-append-version="true"></script>
   
}