@{
    ViewData["Title"] = "Add Training Event";
}

<style>
    .training-event-create-container {
        max-width: 1280px;
        margin: 0 auto;
    }

    .training-event-create-container .form-label {
        margin-bottom: 3px;
        font-size: 13px;
    }

    .training-event-create-container .form-control,
    .training-event-create-container .form-select {
        font-size: 13px;
    }

    .training-event-create-container .form-text {
        font-size: 11px;
    }

    #participantTable th,
    #participantTable td {
        font-size: 13px;
        vertical-align: middle;
    }

    #participantTable th {
        white-space: nowrap;
    }
</style>

<div class="container px-3 px-md-4 training-event-create-container">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="d-flex align-items-center mb-3">

        <i class="bi bi-people-fill fs-4 me-2"></i>

        <h4 class="mb-0">
            Add Training Event
        </h4>

    </div>


    <!-- =========================================================
         FORM
         ========================================================= -->

    <form id="trainingEventForm"
          asp-controller="TrainingEvent"
          asp-action="Create"
          method="post"
          autocomplete="off">

        @Html.AntiForgeryToken()


        <!-- =====================================================
             EVENT INFORMATION
             ===================================================== -->

        <div class="card shadow-sm">

            <div class="card-header py-2">

                <i class="bi bi-calendar-plus me-1"></i>

                Event Information

            </div>


            <div class="card-body">

                <!-- =================================================
                     HIDDEN VALUES
                     ================================================= -->

                <input type="hidden"
                       id="CourseId"
                       name="CourseId" />

                <input type="hidden"
                       id="CategoryId"
                       name="CategoryId" />

                <input type="hidden"
                       id="DeptName"
                       name="DeptName" />


                <!-- =================================================
                     ROW 1
                     Course | Training Title | Category
                     ================================================= -->

                <div class="row g-3">

                    <!-- COURSE -->
                    <div class="col-md-5">

                        <label for="courseSearch"
                               class="form-label">

                            Course
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               id="courseSearch"
                               class="form-control form-control-sm"
                               placeholder="Search course code or course name..."
                               autocomplete="off"
                               required />

                        <div class="form-text">
                            Type at least 2 characters.
                        </div>

                    </div>


                    <!-- TRAINING TITLE -->
                    <div class="col-md-4">

                        <label for="TrainingTitle"
                               class="form-label">

                            Training Title

                        </label>

                        <input type="text"
                               id="TrainingTitle"
                               name="TrainingTitle"
                               class="form-control form-control-sm"
                               readonly />

                    </div>


                    <!-- CATEGORY -->
                    <div class="col-md-3">

                        <label for="CategoryName"
                               class="form-label">

                            Training Category

                        </label>

                        <input type="text"
                               id="CategoryName"
                               class="form-control form-control-sm"
                               readonly />

                    </div>

                </div>


                <!-- =================================================
                     ROW 2
                     Company | Department | Trainer Type | Trainer
                     ================================================= -->

                <div class="row g-3 mt-0">

                    <!-- COMPANY -->
                    <div class="col-md-3">

                        <label for="CoCode"
                               class="form-label">

                            Company
                            <span class="text-danger">*</span>

                        </label>

                        <select id="CoCode"
                                name="CoCode"
                                class="form-select form-select-sm"
                                required>

                            <option value="">
                                -- Select Company --
                            </option>

                        </select>

                    </div>


                    <!-- DEPARTMENT -->
                    <div class="col-md-3">

                        <label for="ABRV"
                               class="form-label">

                            Department
                            <span class="text-danger">*</span>

                        </label>

                        <select id="ABRV"
                                name="ABRV"
                                class="form-select form-select-sm"
                                required>

                            <option value="">
                                -- Select Department --
                            </option>

                        </select>

                    </div>


                    <!-- TRAINER TYPE -->
                    <div class="col-md-2">

                        <label for="TrainerType"
                               class="form-label">

                            Trainer Type

                        </label>

                        <select id="TrainerType"
                                class="form-select form-select-sm">

                            <option value="Internal">
                                Internal
                            </option>

                            <option value="External">
                                External
                            </option>

                        </select>

                    </div>


                    <!-- TRAINER -->
                    <div class="col-md-4">

                        <label for="TrainerSearch"
                               class="form-label">

                            Trainer
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               id="TrainerSearch"
                               class="form-control form-control-sm"
                               placeholder="Search trainer..."
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               id="TrainerEmployeeCode"
                               name="TrainerId" />

                        <input type="hidden"
                               id="TrainerName"
                               name="TrainerName" />

                    </div>

                </div>


                <!-- =================================================
                     ROW 3
                     Session | Duration | Quota | Start | End
                     ================================================= -->

                <div class="row g-3 mt-0">

                    <!-- SESSION -->
                    <div class="col-md-2">

                        <label for="SessionNo"
                               class="form-label">

                            Session#
                            <span class="text-danger">*</span>

                        </label>

                        <input type="number"
                               id="SessionNo"
                               name="SessionCount"
                               class="form-control form-control-sm"
                               min="1"
                               required />

                    </div>


                    <!-- DURATION -->
                    <div class="col-md-2">

                        <label for="HoursPerSession"
                               class="form-label">

                            Duration (Hours)

                        </label>

                        <div class="input-group input-group-sm">

                            <input type="number"
                                   id="HoursPerSession"
                                   name="DurationHours"
                                   class="form-control"
                                   min="0"
                                   step="0.5" />

                            <span class="input-group-text">
                                hrs
                            </span>

                        </div>

                    </div>


                    <!-- QUOTA -->
                    <div class="col-md-2">

                        <label for="Quota"
                               class="form-label">

                            Quota
                            <span class="text-danger">*</span>

                        </label>

                        <input type="number"
                               id="Quota"
                               name="ParticipantQuota"
                               class="form-control form-control-sm"
                               min="1"
                               required />

                    </div>


                    <!-- START DATE -->
                    <div class="col-md-3">

                        <label for="StartDate"
                               class="form-label">

                            Start Date
                            <span class="text-danger">*</span>

                        </label>

                        <input type="datetime-local"
                               id="StartDate"
                               name="EventStartDate"
                               class="form-control form-control-sm"
                               required />

                    </div>


                    <!-- END DATE -->
                    <div class="col-md-3">

                        <label for="EndDate"
                               class="form-label">

                            End Date
                            <span class="text-danger">*</span>

                        </label>

                        <input type="datetime-local"
                               id="EndDate"
                               name="EventEndDate"
                               class="form-control form-control-sm"
                               required />

                    </div>

                </div>


                <!-- =================================================
                     ROW 4
                     Venue | Budget
                     ================================================= -->

                <div class="row g-3 mt-0">

                    <!-- VENUE -->
                    <div class="col-md-8">

                        <label for="Venue"
                               class="form-label">

                            Venue

                        </label>

                        <input type="text"
                               id="Venue"
                               name="Venue"
                               class="form-control form-control-sm" />

                    </div>


                    <!-- BUDGET -->
                    <div class="col-md-4">

                        <label for="Budget"
                               class="form-label">

                            Budget

                        </label>

                        <input type="number"
                               id="Budget"
                               name="Budget"
                               class="form-control form-control-sm"
                               min="0"
                               step="1000"
                               value="0" />

                    </div>

                </div>


                <!-- =================================================
                     ROW 5
                     Training Description
                     ================================================= -->

                <div class="row g-3 mt-0">

                    <div class="col-12">

                        <label for="Description"
                               class="form-label">

                            Training Description

                        </label>

                        <textarea id="Description"
                                  name="TrainingDescription"
                                  class="form-control form-control-sm"
                                  rows="3"></textarea>

                    </div>

                </div>


                <!-- =================================================
                     ROW 6
                     Training Objective
                     ================================================= -->

                <div class="row g-3 mt-0">

                    <div class="col-12">

                        <label for="Objective"
                               class="form-label">

                            Training Objective

                        </label>

                        <textarea id="Objective"
                                  name="TrainingObjective"
                                  class="form-control form-control-sm"
                                  rows="3"></textarea>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             PARTICIPANTS
             ========================================================= -->

        <div class="card shadow-sm mt-2">

            <div class="card-header py-2 d-flex justify-content-between align-items-center">

                <div>

                    <i class="bi bi-person-check me-1"></i>

                    Planned Participants

                </div>


                <button type="button"
                        id="btnAddParticipant"
                        class="btn btn-sm btn-primary">

                    <i class="bi bi-person-plus me-1"></i>

                    Add Participant

                </button>

            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table id="participantTable"
                           class="table table-sm table-hover mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width:50px;"
                                    class="text-center">
                                    #
                                </th>

                                <th style="width:130px;">
                                    Employee Code
                                </th>

                                <th>
                                    Name
                                </th>

                                <th style="width:100px;">
                                    ABRV
                                </th>

                                <th>
                                    Department
                                </th>

                                <th style="width:80px;"
                                    class="text-center">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody id="participantTableBody">
                        </tbody>

                    </table>


                    <div id="participantEmpty"
                         class="text-center text-muted py-3">

                        No participants added.

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             ACTION
             ========================================================= -->

        <div class="d-flex justify-content-end gap-2 mt-3 mb-4">

            <button type="button"
                    id="btnCancel"
                    class="btn btn-sm btn-outline-secondary">

                <i class="bi bi-x-lg me-1"></i>

                Cancel

            </button>


            <button type="button"
                    id="btnSaveEvent"
                    class="btn btn-sm btn-success">

                <i class="bi bi-check-lg me-1"></i>

                Save Event

            </button>

        </div>

    </form>

</div>


<!-- =============================================================
     PARTICIPANT MODAL
============================================================= -->

<div class="modal fade"
     id="participantModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="bi bi-person-plus me-1"></i>

                    Add Participant

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="mb-3">

                    <label for="ParticipantSearch"
                           class="form-label">

                        Employee
                        <span class="text-danger">*</span>

                    </label>

                    <input type="text"
                           id="ParticipantSearch"
                           class="form-control form-control-sm"
                           placeholder="Search employee code or name..."
                           autocomplete="off" />


                    <input type="hidden"
                           id="ParticipantEmployeeCode" />

                    <input type="hidden"
                           id="ParticipantName" />

                    <input type="hidden"
                           id="ParticipantDepartment" />

                    <input type="hidden"
                           id="ParticipantDepartmentName" />

                </div>


                <div id="participantSelectedInfo"
                     class="alert alert-light border d-none">

                    <div class="small">

                        <div>
                            <strong>Employee:</strong>
                            <span id="participantSelectedCode"></span>
                            -
                            <span id="participantSelectedName"></span>
                        </div>

                        <div>
                            <strong>Department:</strong>
                            <span id="participantSelectedDepartment"></span>
                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <button type="button"
                        id="btnConfirmParticipant"
                        class="btn btn-sm btn-primary"
                        disabled>

                    <i class="bi bi-plus-lg me-1"></i>

                    Add

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        window.trainingEventCreateUrls = {

            getCourses:
                '@Url.Action("GetCourses", "TrainingEvent")',

            getCompanies:
                '@Url.Action("GetCompanies", "Home", new { type = "EVENT" })',

            getDepartments:
                '@Url.Action("GetDepartments", "Home", new { type = "EVENT" })',

            searchEmployees:
                '@Url.Action("SearchEmployees", "Home")',

            save:
                '@Url.Action("Create", "TrainingEvent")',

            index:
                '@Url.Action("Index", "TrainingEvent")'

        };

    </script>

    <script src="~/lib/bootstrap3-typeahead/bootstrap3-typeahead.min.js"></script>

    <script src="~/js/training-event-create.js"
            asp-append-version="true"></script>

}